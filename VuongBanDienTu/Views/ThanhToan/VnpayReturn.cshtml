@{
    ViewBag.Title = "Kết quả thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-screen-md mx-auto px-4 py-20">
    <div class="bg-white rounded-[3rem] shadow-2xl shadow-slate-200/50 overflow-hidden border border-slate-50">
        <div class="p-12 text-center">
            @if (ViewBag.InnerText.Contains("thành công"))
            {
                <div class="w-24 h-24 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-8 animate-bounce">
                    <i class="fa fa-check text-4xl text-green-500"></i>
                </div>
                <h1 class="text-3xl font-black text-slate-900 uppercase tracking-tight mb-4">Thanh toán thành công!</h1>
            }
            else
            {
                <div class="w-24 h-24 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-8">
                    <i class="fa fa-xmark text-4xl text-red-500"></i>
                </div>
                <h1 class="text-3xl font-black text-slate-900 uppercase tracking-tight mb-4">Thanh toán thất bại</h1>
            }
            
            <p class="text-slate-500 font-medium mb-10 leading-relaxed px-10">
                @ViewBag.InnerText
            </p>

            <div class="bg-slate-50 rounded-3xl p-8 mb-10 text-left space-y-4">
                <div class="flex justify-between items-center text-xs">
                    <span class="font-black text-slate-400 uppercase tracking-widest">Mã đơn hàng</span>
                    <span class="font-bold text-slate-800">#@ViewBag.OrderId</span>
                </div>
                <div class="flex justify-between items-center text-xs">
                    <span class="font-black text-slate-400 uppercase tracking-widest">Mã giao dịch VNPay</span>
                    <span class="font-bold text-slate-800">@ViewBag.VnpayTranId</span>
                </div>
                <div class="flex justify-between items-center text-xs border-t border-slate-200 pt-4">
                    <span class="font-black text-slate-400 uppercase tracking-widest">Số tiền thanh toán</span>
                    <span class="text-xl font-black text-primary">@(((long)(ViewBag.Amount ?? 0)).ToString("N0"))₫</span>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
                <a href="@Url.Action("Index", "Home")" class="flex-1 h-14 bg-slate-100 text-slate-700 rounded-2xl font-black uppercase tracking-widest flex items-center justify-center hover:bg-slate-200 transition-all">
                    Về trang chủ
                </a>
                <a href="@Url.Action("LichSu", "DonHang")" class="flex-1 h-14 bg-primary text-white rounded-2xl font-black uppercase tracking-widest shadow-xl shadow-red-200 flex items-center justify-center hover:bg-primary-dark hover:-translate-y-1 transition-all">
                    Xem đơn hàng
                </a>
            </div>
        </div>
        
        <div class="bg-slate-900 py-6 text-center">
            <p class="text-[10px] text-white/40 font-black uppercase tracking-[0.2em]">Cảm ơn bạn đã mua sắm tại VuongBanDienTu</p>
        </div>
    </div>
</div>
