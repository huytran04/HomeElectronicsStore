@model VuongBanDienTu.Models.DonHang

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.MaDonHang;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-slate-50 min-h-screen py-12">
    <div class="max-w-4xl mx-auto px-4">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
                <a href="@Url.Action("LichSu", "DonHang")" class="text-xs font-black text-slate-400 uppercase tracking-widest hover:text-primary transition-colors flex items-center gap-2 mb-2">
                    <i class="fa fa-arrow-left"></i> Quay lại lịch sử
                </a>
                <h1 class="text-3xl font-black text-slate-900 uppercase italic">Đơn hàng #ORD-@Model.MaDonHang</h1>
                <p class="text-sm text-slate-500 font-medium mt-1">Đặt ngày @Model.NgayDat.Value.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="flex flex-col items-end gap-2">
                @if (Model.TrangThaiDonHang?.Trim() == "Chờ xử lý")
                {
                    <span class="px-6 py-2 rounded-full bg-amber-100 text-amber-600 text-xs font-black uppercase tracking-widest ring-4 ring-amber-50">Đang chờ xử lý</span>
                    <button onclick="openCancelModal()" class="mt-2 text-xs font-black text-primary hover:text-primary-dark transition-all border border-primary/20 hover:border-primary/50 px-4 py-2 rounded-xl flex items-center gap-1.5 bg-white">
                        <i class="fa fa-times-circle"></i> HỦY ĐƠN HÀNG
                    </button>
                }
                else if (Model.TrangThaiDonHang?.Trim() == "Đã xác nhận")
                {
                    <span class="px-6 py-2 rounded-full bg-green-100 text-green-600 text-xs font-black uppercase tracking-widest ring-4 ring-green-50">Đã xác nhận</span>
                }
                else if (Model.TrangThaiDonHang?.Trim() == "Đang giao")
                {
                    <span class="px-6 py-2 rounded-full bg-blue-100 text-blue-600 text-xs font-black uppercase tracking-widest ring-4 ring-blue-50">Đang giao hàng</span>
                }
                else if (Model.TrangThaiDonHang?.Trim() == "Hoàn thành")
                {
                    <span class="px-6 py-2 rounded-full bg-purple-100 text-purple-600 text-xs font-black uppercase tracking-widest ring-4 ring-purple-50">Hoàn thành</span>
                }
                else if (Model.TrangThaiDonHang?.Trim() == "Chờ hoàn tiền")
                {
                    <span class="px-6 py-2 rounded-full bg-orange-100 text-orange-600 text-xs font-black uppercase tracking-widest ring-4 ring-orange-50">Chờ hoàn tiền</span>
                }
                else if (Model.TrangThaiDonHang?.Trim() == "Đã hủy")
                {
                    <span class="px-6 py-2 rounded-full bg-red-100 text-primary text-xs font-black uppercase tracking-widest ring-4 ring-red-50">Đã hủy bỏ</span>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left: Order Progress & Items -->
            <div class="lg:col-span-8 space-y-8">
                <!-- Progress Stepper -->
                <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100">
                    <div class="flex items-center justify-between relative">
                        <div class="absolute left-0 top-5 w-full h-0.5 bg-slate-100 -z-0"></div>
                        @{
                            var orderStatus = Model.TrangThaiDonHang?.Trim() ?? "";
                        }
                        @if (orderStatus != "Đã hủy" && orderStatus != "Chờ hoàn tiền") {
                            <div class="z-10 text-center">
                                <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center mx-auto mb-2 transition-all shadow-lg shadow-red-100">
                                    <i class="fa fa-clock text-xs"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase text-slate-800">Chờ xử lý</span>
                            </div>
                            <div class="z-10 text-center">
                                <div class="w-10 h-10 rounded-full @(orderStatus == "Đã xác nhận" || orderStatus == "Đang giao" || orderStatus == "Hoàn thành" ? "bg-green-600 text-white" : "bg-slate-200 text-slate-400") flex items-center justify-center mx-auto mb-2 transition-all">
                                    <i class="fa fa-check text-xs"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase text-slate-400">Đã xác nhận</span>
                            </div>
                            <div class="z-10 text-center">
                                <div class="w-10 h-10 rounded-full @(orderStatus == "Đang giao" || orderStatus == "Hoàn thành" ? "bg-blue-600 text-white shadow-lg shadow-blue-100" : "bg-slate-200 text-slate-400") flex items-center justify-center mx-auto mb-2 transition-all">
                                    <i class="fa fa-truck text-xs"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase text-slate-400">Đang giao</span>
                            </div>
                            <div class="z-10 text-center">
                                <div class="w-10 h-10 rounded-full @(orderStatus == "Hoàn thành" ? "bg-purple-600 text-white shadow-lg shadow-purple-100" : "bg-slate-200 text-slate-400") flex items-center justify-center mx-auto mb-2 transition-all">
                                    <i class="fa fa-box-open text-xs"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase text-slate-400">Hoàn thành</span>
                            </div>
                        } else if (orderStatus == "Chờ hoàn tiền") {
                            <div class="z-10 text-center w-full">
                                <div class="w-12 h-12 rounded-full bg-amber-500 text-white flex items-center justify-center mx-auto mb-2 shadow-xl shadow-amber-100">
                                    <i class="fa fa-hand-holding-usd text-xl"></i>
                                </div>
                                <span class="text-xs font-black uppercase text-amber-600">Đơn hàng đang chờ hoàn tiền</span>
                            </div>
                        } else {
                            <div class="z-10 text-center w-full">
                                <div class="w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center mx-auto mb-2 shadow-xl shadow-red-100">
                                    <i class="fa fa-times text-xl"></i>
                                </div>
                                <span class="text-xs font-black uppercase text-primary">Đơn hàng này đã bị hủy</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Product List -->
                <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-8 border-b border-slate-50 flex justify-between items-center">
                        <h3 class="text-sm font-black text-slate-800 uppercase tracking-widest">Sản phẩm trong đơn</h3>
                        <span class="text-xs font-bold text-slate-400">@Model.ChiTietDonHangs.Count() món</span>
                    </div>
                    <div class="divide-y divide-slate-50">
                        @foreach (var item in Model.ChiTietDonHangs)
                        {
                            <div class="p-8 flex items-center gap-6 group hover:bg-slate-50/50 transition-all">
                                <div class="w-20 h-20 bg-slate-100 rounded-2xl p-3 flex-shrink-0">
                                    @{
                                        var mainImg = item.SanPham.HinhAnhSanPhams.FirstOrDefault(h => h.AnhChinh);
                                        var imgUrl = mainImg != null ? mainImg.DuongDanAnh : "default.jpg";
                                    }
                                    <img src="~/Content/Images/Products/@imgUrl" alt="@item.SanPham.TenSanPham" class="w-full h-full object-contain transform group-hover:scale-110 transition-transform duration-500">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-sm font-black text-slate-800 line-clamp-1 mb-1">@item.SanPham.TenSanPham</h4>
                                    <p class="text-xs text-slate-400 font-medium italic">Số lượng: @item.SoLuong x @(item.GiaLuuTru.ToString("N0"))₫</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm font-black text-primary">@((item.SoLuong * item.GiaLuuTru).ToString("N0"))₫</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="bg-slate-50 p-8 space-y-4">
                        <div class="flex justify-between items-center text-xs font-bold text-slate-500 uppercase tracking-widest">
                            <span>Tạm tính</span>
                            <span>@Model.TongTien.Value.ToString("N0")₫</span>
                        </div>
                        <div class="flex justify-between items-center text-xs font-bold text-slate-500 uppercase tracking-widest">
                            <span>Phí vận chuyển</span>
                            <span class="text-green-600">Miễn phí</span>
                        </div>
                        <div class="pt-4 border-t border-slate-200 flex justify-between items-center">
                            <span class="text-sm font-black text-slate-900 uppercase tracking-widest">Tổng thanh toán</span>
                            <span class="text-2xl font-black text-primary italic">@Model.TongTien.Value.ToString("N0")₫</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Info Details -->
            <div class="lg:col-span-4 space-y-8">
                <!-- Delivery Info -->
                <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6">Thông tin giao hàng</h3>
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 flex-shrink-0">
                                <i class="fa fa-user text-[10px]"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase mb-0.5">Người nhận</p>
                                <p class="text-sm font-bold text-slate-800">@(Model.NguoiDung != null ? Model.NguoiDung.HoTen : "Khách hàng")</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 flex-shrink-0">
                                <i class="fa fa-phone text-[10px]"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase mb-0.5">Số điện thoại</p>
                                <p class="text-sm font-bold text-slate-800">@(Model.NguoiDung != null ? Model.NguoiDung.SoDienThoai : "---")</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 flex-shrink-0">
                                <i class="fa fa-map-marker-alt text-[10px]"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase mb-0.5">Địa chỉ nhận hàng</p>
                                <p class="text-sm font-bold text-slate-800 leading-relaxed">@Model.DiaChiGiaoHang</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Info -->
                <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6">Thanh toán</h3>
                    <div class="space-y-4">
                        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                            <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Phương thức</p>
                            <p class="text-xs font-bold text-slate-800">@(Model.PhuongThucThanhToan == "COD" ? "Thanh toán khi nhận hàng (COD)" : Model.PhuongThucThanhToan)</p>
                        </div>
                        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                            <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Trạng thái</p>
                            @if (Model.TrangThaiThanhToan == "Đã thanh toán")
                            {
                                <span class="text-xs font-black text-green-600 uppercase">Đã thanh toán</span>
                            }
                            else if (Model.TrangThaiThanhToan == "Đã hoàn tiền")
                            {
                                <span class="text-xs font-black text-primary uppercase">Đã hoàn tiền</span>
                            }
                            else if (Model.TrangThaiThanhToan == "Chờ hoàn tiền")
                            {
                                <span class="text-xs font-black text-amber-600 uppercase">Chờ hoàn tiền</span>
                            }
                            else
                            {
                                <span class="text-xs font-black text-amber-500 uppercase">Chưa thanh toán</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CANCEL MODAL FOR CUSTOMER -->
@if (Model.TrangThaiDonHang?.Trim() == "Chờ xử lý")
{
    <div id="cancelModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" onclick="closeCancelModal()"></div>
            <div class="relative bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden transform transition-all scale-95 opacity-0 duration-300 p-8" id="cancelModalContainer">
                <h3 class="text-xl font-black text-slate-800 mb-2 uppercase italic tracking-tight">Hủy đơn hàng #ORD-@Model.MaDonHang</h3>
                <p class="text-xs text-slate-400 font-medium mb-6 leading-relaxed">Bạn có chắc chắn muốn hủy đơn hàng này không? Vui lòng nhập lý do hủy đơn hàng bên dưới để chúng tôi cải thiện chất lượng dịch vụ.</p>
                
                <div class="mb-6">
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Lý do hủy đơn *</label>
                    <textarea id="cancelReason" required class="w-full bg-slate-50 border border-slate-100 focus:border-primary/30 focus:bg-white rounded-2xl px-4 py-3 text-sm font-bold text-slate-800 outline-none transition-all h-28" placeholder="Ví dụ: Tôi muốn đổi sản phẩm khác, Nhập sai địa chỉ nhận hàng,..."></textarea>
                </div>
                
                <div class="flex flex-col gap-3">
                    <button id="confirmCancelBtn" onclick="submitCancelOrder()" class="w-full bg-primary text-white py-3.5 rounded-2xl font-black uppercase tracking-widest shadow-lg shadow-red-200 hover:bg-primary-dark transition-all">Xác nhận hủy đơn</button>
                    <button onclick="closeCancelModal()" class="w-full bg-slate-50 text-slate-500 py-3.5 rounded-2xl font-bold uppercase tracking-widest hover:bg-slate-100 transition-all">Quay lại</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const cancelModal = document.getElementById('cancelModal');
        const cancelModalContainer = document.getElementById('cancelModalContainer');

        function openCancelModal() {
            cancelModal.classList.remove('hidden');
            setTimeout(() => {
                cancelModalContainer.classList.remove('scale-95', 'opacity-0');
            }, 10);
        }

        function closeCancelModal() {
            cancelModalContainer.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                cancelModal.classList.add('hidden');
            }, 300);
        }

        function submitCancelOrder() {
            const reason = document.getElementById('cancelReason').value.trim();
            if (!reason) {
                showNotification('Vui lòng nhập lý do hủy đơn!', 'error');
                return;
            }

            const btn = document.getElementById('confirmCancelBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-circle-notch fa-spin mr-2"></i> Đang xử lý...';

            $.ajax({
                url: '@Url.Action("HuyDon", "DonHang")',
                type: 'POST',
                data: { id: @Model.MaDonHang, lyDo: reason },
                success: function (res) {
                    if (res.success) {
                        closeCancelModal();
                        showNotification(res.message || 'Hủy đơn hàng thành công!', 'success');
                        setTimeout(() => location.reload(), 1800);
                    } else {
                        showNotification(res.message || 'Có lỗi xảy ra!', 'error');
                        btn.disabled = false;
                        btn.innerHTML = 'Xác nhận hủy đơn';
                    }
                },
                error: function () {
                    showNotification('Lỗi kết nối hệ thống!', 'error');
                    btn.disabled = false;
                    btn.innerHTML = 'Xác nhận hủy đơn';
                }
            });
        }

        function showNotification(message, type) {
            const existing = document.getElementById('cancelToast');
            if (existing) existing.remove();

            const colors = type === 'success'
                ? 'bg-green-600 text-white shadow-green-200'
                : 'bg-primary text-white shadow-red-200';
            const icon = type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation';

            const toast = document.createElement('div');
            toast.id = 'cancelToast';
            toast.className = `fixed bottom-6 left-1/2 -translate-x-1/2 z-[200] flex items-center gap-3 px-6 py-4 rounded-2xl shadow-xl ${colors} text-sm font-bold transition-all duration-500 opacity-0 scale-95`;
            toast.innerHTML = `<i class="fa ${icon}"></i> ${message}`;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('opacity-0', 'scale-95');
                toast.classList.add('opacity-100', 'scale-100');
            }, 10);
            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 500);
            }, 3000);
        }
    </script>
}
