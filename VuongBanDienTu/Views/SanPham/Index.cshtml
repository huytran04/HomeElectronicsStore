@model IEnumerable<VuongBanDienTu.Models.SanPham>
@using VuongBanDienTu.Helpers

@{
    var currentCat = ViewBag.CurrentCategory as VuongBanDienTu.Models.DanhMuc;
    ViewBag.Title = currentCat != null ? currentCat.TenDanhMuc : "Tất cả sản phẩm";
}

<div class="max-w-screen-xl mx-auto px-4 py-8 flex gap-6">
    <!-- Sidebar for filtering -->
    <aside class="sticky top-[76px] hidden md:flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm flex-shrink-0 w-60 border border-slate-100 self-start z-10">
        <div class="bg-slate-50 px-4 py-3 border-b border-slate-100">
            <h3 class="text-xs font-black text-slate-800 uppercase tracking-widest">Danh mục</h3>
        </div>
        <ul class="flex-1 py-1">
            <li class="transition-colors hover:bg-red-50 @(currentCat == null ? "bg-red-50 text-primary font-bold" : "text-slate-600")">
                <a href="@Url.Action("Index", "SanPham", new { id = "" })" class="flex items-center gap-2 px-4 py-2.5 text-xs">
                    <i class="fa fa-grid-2 text-[10px]"></i> Tất cả sản phẩm
                </a>
            </li>
            @if (ViewBag.Categories != null)
            {
                foreach (var cat in (IEnumerable<VuongBanDienTu.Models.DanhMuc>)ViewBag.Categories)
                {
                    <li class="transition-colors hover:bg-red-50 @(currentCat != null && currentCat.MaDanhMuc == cat.MaDanhMuc ? "bg-red-50 text-primary font-bold" : "text-slate-600")">
                        <a href="@Url.Action("Index", "SanPham", new { id = cat.MaDanhMuc })" class="flex items-center justify-between px-4 py-2.5 text-xs">
                            <span class="truncate">@cat.TenDanhMuc</span>
                            @if (currentCat != null && currentCat.MaDanhMuc == cat.MaDanhMuc)
                            {
                                <i class="fa fa-check text-[8px]"></i>
                            }
                        </a>
                    </li>
                }
            }
        </ul>
    </aside>

    <div class="flex-1 min-w-0">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-black text-slate-800 uppercase tracking-tight">
                    @(ViewBag.SearchQuery != null ? "KẾT QUẢ TÌM KIẾM: \"" + ViewBag.SearchQuery + "\"" : (currentCat != null ? currentCat.TenDanhMuc : "Tất cả sản phẩm"))
                </h1>
                <p class="text-sm text-slate-500 mt-1">
                    @(ViewBag.SearchQuery != null ? "Tìm thấy " + (Model != null ? Model.Count() : 0) + " sản phẩm phù hợp" : (currentCat != null ? "Danh sách sản phẩm thuộc nhóm " + currentCat.TenDanhMuc : "Khám phá hàng ngàn ưu đãi hấp dẫn tại VuongBanDienTu"))
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs font-bold text-slate-400 uppercase">Sắp xếp:</span>
                <select id="sortSelect" onchange="changeSort(this.value)" class="bg-white border border-slate-200 rounded-lg px-3 py-2 text-xs font-semibold text-slate-700 outline-none focus:border-primary transition-colors cursor-pointer">
                    <option value="newest" @(ViewBag.CurrentSort == "newest" || string.IsNullOrEmpty(ViewBag.CurrentSort) ? "selected" : "")>Mới nhất</option>
                    <option value="price_asc" @(ViewBag.CurrentSort == "price_asc" ? "selected" : "")>Giá thấp đến cao</option>
                    <option value="price_desc" @(ViewBag.CurrentSort == "price_desc" ? "selected" : "")>Giá cao đến thấp</option>
                    <option value="best_seller" @(ViewBag.CurrentSort == "best_seller" ? "selected" : "")>Bán chạy nhất</option>
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="prod-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all cursor-pointer relative group border border-slate-100 flex flex-col h-full" onclick="location.href='@Url.Action("ChiTiet", "SanPham", new { id = item.MaSanPham })'">
                    <div class="h-48 sm:h-56 flex items-center justify-center p-4 overflow-hidden relative">
                        @{
                            var mainImage = item.HinhAnhSanPhams.FirstOrDefault(h => h.AnhChinh);
                            var secondaryImages = item.HinhAnhSanPhams.Where(h => !h.AnhChinh).ToList();
                        }
                        @if (mainImage != null)
                        {
                            <img src="@HinhAnh.GetImageUrl(mainImage.DuongDanAnh, true)" alt="@item.TenSanPham" class="main-img max-h-full object-contain transition-all duration-500 group-hover:scale-105 @(secondaryImages.Any() ? "group-hover:opacity-0" : "")" />
                            if (secondaryImages.Any())
                            {
                                var secondaryImg = secondaryImages.First().DuongDanAnh;
                                <img src="@HinhAnh.GetImageUrl(secondaryImg, false)" alt="@item.TenSanPham" class="secondary-img absolute inset-0 m-auto max-h-full object-contain opacity-0 group-hover:opacity-100 transition-all duration-500 scale-95 group-hover:scale-105" />
                            }
                        }
                        else
                        {
                            <div class="flex flex-col items-center gap-2">
                                <i class="fa fa-image text-slate-200 text-5xl"></i>
                                <span class="text-[10px] text-slate-300 uppercase font-black tracking-widest">No Image</span>
                            </div>
                        }
                    </div>
                    
                    <div class="px-4 pb-4 flex-1 flex flex-col">
                        <div class="mb-3">
                            <h3 class="text-sm font-medium text-slate-700 line-clamp-2 h-10 mb-1 leading-snug group-hover:text-primary transition-colors">@(string.IsNullOrEmpty(item.TenSanPham) ? "Sản phẩm chưa có tên" : item.TenSanPham)</h3>
                            
                            <div class="flex flex-col gap-0.5 mb-2">
                                <div class="text-base font-bold text-primary">@(item.GiaBan > 0 ? item.GiaBan.ToString("N0") + "₫" : "Liên hệ")</div>
                                @if (item.GiaBan > 1000000) {
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs text-slate-400 line-through">@((item.GiaBan * 1.2m).ToString("N0"))₫</span>
                                        <span class="bg-primary text-white text-[10px] font-black px-1.5 py-0.5 rounded">-20%</span>
                                    </div>
                                }
                            </div>

                            <div class="space-y-1 text-[11px] text-slate-500 font-medium h-20 overflow-hidden">
                                @if (!string.IsNullOrEmpty(item.ThongSoKyThuat))
                                {
                                    var specs = item.ThongSoKyThuat.Split(new[] { '\n', '\r', ';', '|' }, StringSplitOptions.RemoveEmptyEntries);
                                    foreach (var spec in specs.Take(4))
                                    {
                                        <div class="truncate">• @spec.Trim()</div>
                                    }
                                }
                                else
                                {
                                    <div class="truncate">Đang cập nhật thông số...</div>
                                    <div class="truncate">Nhà sản xuất: @(item.DanhMuc != null ? item.DanhMuc.TenDanhMuc : "Đang cập nhật")</div>
                                    <div class="truncate">Bảo hành: 12-24 tháng</div>
                                }
                            </div>
                        </div>

                        <div class="mt-auto pt-3 border-t border-slate-50 space-y-2">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2 text-[10px] text-slate-400">
                                    <span class="flex items-center gap-1">
                                        <i class="fa fa-shopping-cart"></i>
                                        <span>Đã bán @(item.ChiTietDonHangs != null ? item.ChiTietDonHangs.Sum(c => c.SoLuong) : 0)</span>
                                    </span>
                                    <span>•</span>
                                    @if (item.SoLuongTon.HasValue && item.SoLuongTon.Value > 0)
                                    {
                                        <span class="text-green-600 font-bold">Còn @item.SoLuongTon</span>
                                    }
                                    else
                                    {
                                        <span class="text-red-500 font-black">Hết hàng</span>
                                    }
                                </div>
                                <div class="flex items-center gap-0.5 text-yellow-400 text-[10px]">
                                    <i class="fa fa-star"></i>
                                    <span class="text-slate-400 font-bold">4.8</span>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                @if (item.SoLuongTon.HasValue && item.SoLuongTon.Value > 0)
                                {
                                    <button onclick="addToCart(@item.MaSanPham, event, false)" class="flex-1 py-1.5 bg-slate-50 hover:bg-red-50 text-slate-600 hover:text-primary text-[10px] font-black uppercase rounded-lg border border-slate-100 hover:border-primary/20 transition-all tracking-wider text-center">
                                        Thêm giỏ
                                    </button>
                                    <button onclick="addToCart(@item.MaSanPham, event, true)" class="flex-1 py-1.5 bg-primary hover:bg-primary-dark text-white text-[10px] font-black uppercase rounded-lg shadow-sm hover:shadow transition-all tracking-wider text-center">
                                        Mua ngay
                                    </button>
                                }
                                else
                                {
                                    <button disabled class="flex-1 py-1.5 bg-slate-100 text-slate-400 text-[10px] font-black uppercase rounded-lg border border-slate-200 cursor-not-allowed tracking-wider text-center">
                                        Thêm giỏ
                                    </button>
                                    <button disabled class="flex-1 py-1.5 bg-slate-200 text-slate-400 text-[10px] font-black uppercase rounded-lg cursor-not-allowed tracking-wider text-center">
                                        Mua ngay
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full py-24 text-center bg-white rounded-3xl shadow-sm border-2 border-dashed border-slate-100">
                <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fa fa-search text-slate-200 text-3xl"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-800">Không tìm thấy sản phẩm</h3>
                <p class="text-slate-400 text-sm mt-2">Dữ liệu đang được cập nhật, vui lòng quay lại sau!</p>
                <a href="@Url.Action("Index", "Home")" class="inline-block mt-8 px-8 py-3 bg-primary text-white rounded-full text-xs font-black uppercase tracking-widest shadow-lg shadow-red-200 hover:-translate-y-0.5 transition-all">Quay về trang chủ</a>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="flex items-center justify-center mt-12">
            <nav class="isolate inline-flex -space-x-px rounded-2xl shadow-sm bg-white p-2 border border-slate-100 gap-1.5" aria-label="Pagination">
                <!-- Prev Button -->
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { id = ViewBag.CurrentId, q = ViewBag.SearchQuery, sort = ViewBag.CurrentSort, page = ViewBag.CurrentPage - 1 })" class="relative inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-500 hover:bg-red-50 hover:text-primary transition-all">
                        <i class="fa fa-chevron-left text-xs"></i>
                    </a>
                }
                else
                {
                    <span class="relative inline-flex items-center justify-center w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 text-slate-300 cursor-not-allowed">
                        <i class="fa fa-chevron-left text-xs"></i>
                    </span>
                }

                <!-- Page Numbers -->
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="relative z-10 inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary text-white text-sm font-black select-none">
                            @i
                        </span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new { id = ViewBag.CurrentId, q = ViewBag.SearchQuery, sort = ViewBag.CurrentSort, page = i })" class="relative inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-700 text-sm font-bold hover:bg-red-50 hover:text-primary transition-all select-none">
                            @i
                        </a>
                    }
                }

                <!-- Next Button -->
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { id = ViewBag.CurrentId, q = ViewBag.SearchQuery, sort = ViewBag.CurrentSort, page = ViewBag.CurrentPage + 1 })" class="relative inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-500 hover:bg-red-50 hover:text-primary transition-all">
                        <i class="fa fa-chevron-right text-xs"></i>
                    </a>
                }
                else
                {
                    <span class="relative inline-flex items-center justify-center w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 text-slate-300 cursor-not-allowed">
                        <i class="fa fa-chevron-right text-xs"></i>
                    </span>
                }
            </nav>
        </div>
    }
</div>
</div>

<script>
    function changeSort(sortVal) {
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('sort', sortVal);
        window.location.search = urlParams.toString();
    }
</script>
