@{
    var user = Session["TaiKhoan"] as VuongBanDienTu.Models.NguoiDung;
    if (user == null || !VuongBanDienTu.Helpers.PhanQuyen.IsStaff(user.MaVaiTro))
    {
        Response.Redirect(Url.Action("DangNhap", "TaiKhoan"));
    }

    var layoutAvatarPath = "";
    bool hasLayoutAvatar = false;
    if (user != null)
    {
        layoutAvatarPath = "/Content/Avatars/avatar_" + user.MaNguoiDung + ".png";
        hasLayoutAvatar = System.IO.File.Exists(Server.MapPath("~" + layoutAvatarPath));
    }

    // Fetch 5 most recent activities for notification dropdown
    List<VuongBanDienTu.Models.LichSuHoatDong> layoutRecentLogs = new List<VuongBanDienTu.Models.LichSuHoatDong>();
    try
    {
        VuongBanDienTu.Helpers.ActivityLogger.CheckAndCreateTable();
        using (var db = new VuongBanDienTu.Models.VuongDienTuEntities())
        {
            layoutRecentLogs = db.Database.SqlQuery<VuongBanDienTu.Models.LichSuHoatDong>(
                "SELECT TOP 5 * FROM LichSuHoatDong ORDER BY ThoiGian DESC"
            ).ToList();
        }
    }
    catch (Exception)
    {
        // Fallback
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Quản trị VươngBánĐiệnTử</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#e8192c',
                        'primary-dark': '#c0001a',
                        sidebar: '#1e293b',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body { font-family: 'Inter', sans-serif; }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800">

    <div class="flex min-h-screen">
        <!-- Backdrop -->
        <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-[90] hidden transition-opacity duration-300 opacity-0"></div>

        <!-- Thanh điều hướng bên cạnh (Sidebar) -->
        <aside id="adminSidebar" class="w-64 bg-sidebar text-slate-300 flex-shrink-0 flex flex-col fixed inset-y-0 left-0 z-[100] transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out md:flex">
            <div class="p-6">
                <a href="/" class="flex items-center gap-2">
                    <span class="text-xl font-black italic text-white tracking-tight">
                        <span class="text-yellow-400">VƯƠNG</span>ADMIN
                    </span>
                </a>
            </div>

            <nav class="flex-1 px-4 py-2 space-y-1 overflow-y-auto scrollbar-hide">
                <p class="px-3 text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-2">Chung</p>
                @if (user.MaVaiTro == 1 || user.MaVaiTro == 2)
                {
                    <a href="/QuanTri/TongQuan" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa fa-chart-line w-5 text-center"></i>
                        <span class="text-sm font-medium">Tổng Quan</span>
                    </a>
                }

                <a href="/QuanLySanPham/Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                    <i class="fa fa-box w-5 text-center"></i>
                    <span class="text-sm font-medium">Sản phẩm</span>
                </a>

                @if (user.MaVaiTro == 1 || user.MaVaiTro == 2 || user.MaVaiTro == 3)
                {
                    <a href="/QuanLyDonHang/Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-sidebar group transition-colors">
                        <i class="fa fa-shopping-cart w-5 text-center group-hover:text-primary transition-colors"></i>
                        <span class="text-sm font-medium">Quản lý đơn hàng</span>
                    </a>
                }

                @if (user.MaVaiTro == 1 || user.MaVaiTro == 2)
                {
                    <a href="/QuanLyDanhMuc/Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-sidebar group transition-colors">
                        <i class="fa fa-layer-group w-5 text-center group-hover:text-primary transition-colors"></i>
                        <span class="text-sm font-medium">Danh mục</span>
                    </a>
                }

                @if (user.MaVaiTro == 1 || user.MaVaiTro == 2)
                {
                    <p class="px-3 text-[10px] font-bold uppercase tracking-wider text-slate-500 mt-6 mb-2">Hệ thống @(user.MaVaiTro == 1 ? "(Admin)" : "(Quản lý)")</p>
                    <a href="/QuanLyNguoiDung/Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-sidebar group transition-colors">
                        <i class="fa fa-users w-5 text-center group-hover:text-primary transition-colors"></i>
                        <span class="text-sm font-medium">Người dùng</span>
                    </a>
                }
                
                @if (user.MaVaiTro == 1 || user.MaVaiTro == 2)
                {
                    <a href="@Url.Action("BaoCaoDoanhThu", "QuanTri")" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa fa-file-invoice-dollar w-5 text-center"></i>
                        <span class="text-sm font-medium">Báo cáo doanh thu</span>
                    </a>

                    <a href="@Url.Action("LichSuHoatDong", "QuanTri")" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa fa-history w-5 text-center"></i>
                        <span class="text-sm font-medium">Lịch sử hoạt động</span>
                    </a>
                }

                @if (user.MaVaiTro == 1)
                {
                    <a href="@Url.Action("CaiDat", "QuanTri")" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                        <i class="fa fa-gear w-5 text-center"></i>
                        <span class="text-sm font-medium">Cài đặt</span>
                    </a>
                }
            </nav>

            <!-- Sidebar Footer Spacer -->
            <div class="p-4 mt-auto">
            </div>
        </aside>

        <!-- Nội dung chính (Main Content) -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden md:ml-64">
            <!-- Thanh điều hướng trên (Top Nav) -->
            <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0">
                <div class="flex items-center gap-4">
                    <button id="sidebarToggle" class="md:hidden text-slate-600 p-2 -ml-2 hover:bg-slate-50 rounded-lg transition-colors">
                        <i class="fa fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-lg font-bold text-slate-800">@ViewBag.Title</h1>
                </div>
                <div class="flex items-center gap-3">
                    <!-- Xem Website Button -->
                    <a href="/" target="_blank" class="flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 text-slate-600 hover:text-primary hover:border-primary/30 hover:bg-red-50/20 transition-all text-xs font-bold shadow-sm">
                        <i class="fa fa-globe text-sm text-slate-400"></i>
                        <span class="hidden sm:inline">Xem Website</span>
                    </a>

                    <!-- Notification Dropdown -->
                    <div class="relative" id="notificationDropdown">
                        <button id="notificationBtn" class="relative w-9 h-9 rounded-xl border border-slate-200 text-slate-500 hover:text-primary hover:border-primary/30 hover:bg-red-50/20 transition-all flex items-center justify-center shadow-sm focus:outline-none">
                            <i class="fa fa-bell text-sm"></i>
                            @if (layoutRecentLogs.Any())
                            {
                                <span class="absolute top-1.5 right-1.5 w-2.5 h-2.5 rounded-full bg-primary ring-2 ring-white animate-pulse"></span>
                            }
                        </button>

                        <div id="notificationMenu" class="absolute right-0 top-full mt-2 w-80 sm:w-96 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 hidden z-[100] transition-all duration-300">
                            <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
                                <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Hoạt động hệ thống</span>
                                <span class="px-2 py-0.5 rounded-full bg-red-50 text-primary text-[10px] font-bold">Mới nhất</span>
                            </div>

                            <div class="max-h-[320px] overflow-y-auto divide-y divide-slate-50 scrollbar-hide">
                                @if (layoutRecentLogs.Any())
                                {
                                    foreach (var log in layoutRecentLogs)
                                    {
                                        string timeString = log.ThoiGian.ToString("dd/MM HH:mm");
                                        var diff = DateTime.Now - log.ThoiGian;
                                        if (diff.TotalMinutes < 60)
                                        {
                                            timeString = $"{(int)diff.TotalMinutes} phút trước";
                                            if ((int)diff.TotalMinutes <= 0) { timeString = "Vừa xong"; }
                                        }
                                        else if (diff.TotalHours < 24)
                                        {
                                            timeString = $"{(int)diff.TotalHours} giờ trước";
                                        }

                                        string statusClass = "bg-slate-100 text-slate-600";
                                        if (log.TrangThai == "Thành công" || log.TrangThai == "Đã xác nhận" || log.TrangThai == "Hoàn thành")
                                        {
                                            statusClass = "bg-green-50 text-green-600 border border-green-100";
                                        }
                                        else if (log.TrangThai == "Thất bại" || log.TrangThai == "Đã hủy")
                                        {
                                            statusClass = "bg-red-50 text-red-600 border border-red-100";
                                        }
                                        else if (log.TrangThai == "Chờ xử lý" || log.TrangThai == "Chờ thanh toán")
                                        {
                                            statusClass = "bg-amber-50 text-amber-600 border border-amber-100";
                                        }

                                        string roleBadge = "bg-slate-100 text-slate-500";
                                        if (log.VaiTro == "Admin") { roleBadge = "bg-red-100 text-red-700 font-bold"; }
                                        else if (log.VaiTro == "Quản lý") { roleBadge = "bg-blue-100 text-blue-700 font-bold"; }
                                        else if (log.VaiTro == "Nhân viên") { roleBadge = "bg-purple-100 text-purple-700 font-bold"; }
                                        else if (log.VaiTro == "Thử việc") { roleBadge = "bg-amber-100 text-amber-700 font-bold"; }

                                        <div class="px-4 py-3 hover:bg-slate-50 transition-colors flex gap-3">
                                            <div class="flex-shrink-0">
                                                <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-xs uppercase border border-slate-200">
                                                    @(string.IsNullOrEmpty(log.TenDangNhap) ? "KH" : log.TenDangNhap.Substring(0, Math.Min(log.TenDangNhap.Length, 2)))
                                                </div>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <span class="text-xs font-bold text-slate-800">@log.HoTen</span>
                                                    <span class="text-[9px] px-1.5 py-0.5 rounded @roleBadge">@log.VaiTro</span>
                                                </div>
                                                <p class="text-xs text-slate-600 mt-1 break-words"><span class="font-medium text-slate-800">@log.HanhDong</span>: @log.ChiTiet</p>
                                                <div class="flex items-center justify-between mt-2">
                                                    <span class="text-[10px] text-slate-400"><i class="fa-regular fa-clock mr-1"></i>@timeString</span>
                                                    <span class="text-[9px] px-1.5 py-0.5 rounded-full @statusClass">@log.TrangThai</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="px-4 py-6 text-center text-slate-400 text-xs">
                                        <i class="fa fa-circle-info text-lg mb-2 block"></i>
                                        Không có hoạt động nào gần đây.
                                    </div>
                                }
                            </div>

                            @if (user.MaVaiTro == 1 || user.MaVaiTro == 2)
                            {
                                <a href="@Url.Action("LichSuHoatDong", "QuanTri")" class="block text-center py-2.5 border-t border-slate-100 text-xs font-bold text-slate-500 hover:text-primary hover:bg-slate-50 transition-all uppercase tracking-wider">
                                    Xem tất cả lịch sử hoạt động
                                </a>
                            }
                        </div>
                    </div>

                    <div class="relative flex items-center gap-3 cursor-pointer group py-2" id="userMenuBtn">
                        @if (hasLayoutAvatar)
                        {
                            <img src="@(layoutAvatarPath + "?t=" + DateTime.Now.Ticks)" alt="Avatar" class="w-8 h-8 rounded-full border border-primary/20 object-cover shadow-sm ring-2 ring-primary/20" />
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white font-bold text-xs ring-2 ring-primary/20">
                                @(user != null ? user.TenDangNhap.Substring(0, 2).ToUpper() : "AD")
                            </div>
                        }
                        <div class="hidden sm:block text-left">
                            <p class="text-xs font-bold text-slate-700 leading-tight">@(user != null ? user.HoTen : "Quản trị viên")</p>
                            <p class="text-[10px] font-medium text-slate-400">
                                Vai trò: <span class="text-primary font-bold">
                                    @(user?.MaVaiTro == 1 ? "Admin" : (user?.MaVaiTro == 2 ? "Quản lý" : (user?.MaVaiTro == 3 ? "Nhân viên" : (user?.MaVaiTro == 5 ? "Thử việc" : "Khách hàng"))))
                                </span>
                            </p>
                        </div>
                        <i class="fa fa-chevron-down text-[10px] text-slate-400 group-hover:text-slate-600 transition-colors"></i>

                        <!-- Dropdown Menu -->
                        <div class="absolute right-0 top-full mt-1 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 hidden group-hover:block hover:block z-50 transition-all duration-300">
                            <div class="px-4 py-3 border-b border-slate-100">
                                <p class="text-xs font-black text-slate-800">@(user != null ? user.HoTen : "Quản trị viên")</p>
                                <p class="text-[10px] text-slate-400 mt-0.5 truncate">@(user != null ? user.Email : "admin@vuongbdt.vn")</p>
                                <div class="mt-2 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-red-50 text-primary text-[9px] font-black uppercase">
                                    <i class="fa fa-shield"></i> @(user?.MaVaiTro == 1 ? "Admin" : (user?.MaVaiTro == 2 ? "Quản lý" : (user?.MaVaiTro == 3 ? "Nhân viên" : (user?.MaVaiTro == 5 ? "Thử việc" : "Khách hàng"))))
                                </div>
                            </div>
                            
                            <a href="@Url.Action("DangXuat", "TaiKhoan")" class="flex items-center gap-2.5 px-4 py-3 text-xs font-bold text-slate-500 hover:text-primary hover:bg-red-50/50 transition-colors">
                                <i class="fa fa-right-from-bracket"></i> ĐĂNG XUẤT
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Khu vực nội dung -->
            <main class="flex-1 overflow-y-auto p-6 scrollbar-hide bg-slate-50/50">
                @RenderBody()
            </main>
        </div>
    </div>

    @Html.Partial("_ThongBaoToast")

    <script>
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggleBtn = document.getElementById('sidebarToggle');

        if (toggleBtn && sidebar && overlay) {
            toggleBtn.addEventListener('click', toggleSidebar);
            overlay.addEventListener('click', closeSidebar);

            function toggleSidebar() {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                if (isOpen) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            }

            function openSidebar() {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.add('opacity-100'), 10);
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.remove('opacity-100');
                document.body.style.overflow = '';
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        // Notification dropdown toggle
        const notificationBtn = document.getElementById('notificationBtn');
        const notificationMenu = document.getElementById('notificationMenu');
        
        if (notificationBtn && notificationMenu) {
            notificationBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                notificationMenu.classList.toggle('hidden');
            });
            
            document.addEventListener('click', (e) => {
                if (!notificationMenu.classList.contains('hidden') && !notificationMenu.contains(e.target) && e.target !== notificationBtn) {
                    notificationMenu.classList.add('hidden');
                }
            });
        }
    </script>
    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
</body>
</html>
