@model IEnumerable<VuongBanDienTu.Models.DanhMuc>

<div class="bg-white rounded-xl shadow-xl border border-slate-100 py-2 w-[calc(100vw-1.5rem)] sm:w-64">
    <div class="px-4 py-3 border-b border-slate-50 mb-1">
        <p class="text-base font-black text-primary uppercase tracking-[0.1em]">Danh mục sản phẩm</p>
    </div>
    <div class="max-h-[60vh] overflow-y-auto scrollbar-hide">
        <a href="@Url.Action("Index", "SanPham", new { id = "" })" class="flex items-center gap-2 px-4 py-3 text-base text-slate-800 hover:bg-slate-50 hover:text-primary transition-colors font-black border-b border-slate-50">
            <i class="fa fa-list text-sm text-primary"></i>
            <span>Tất cả sản phẩm</span>
        </a>
        @foreach (var cat in Model)
        {
            <a href="@Url.Action("Index", "SanPham", new { id = cat.MaDanhMuc })" class="flex items-center gap-2 px-4 py-3 text-base text-slate-600 hover:bg-slate-50 hover:text-primary transition-colors font-black">
                <i class="fa fa-chevron-right text-xs opacity-50"></i>
                <span>@cat.TenDanhMuc</span>
            </a>
        }
    </div>
</div>
