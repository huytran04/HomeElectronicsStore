@model IEnumerable<VuongBanDienTu.Models.SanPham>
@using VuongBanDienTu.Helpers
@{
    ViewBag.Title = "Trang chủ";
    var newest = ViewBag.NewestProduct as VuongBanDienTu.Models.SanPham;
    var bestSeller = ViewBag.BestSellerProduct as VuongBanDienTu.Models.SanPham;
    var featured = ViewBag.FeaturedProduct as VuongBanDienTu.Models.SanPham;
    var config = VuongBanDienTu.Helpers.CauHinhHelper.LayCauHinh();
}

<div class="max-w-screen-xl mx-auto px-3 pt-1.5 pb-3">

    <!-- ===================== HERO SECTION ===================== -->
    <!--
        Breakpoints:
        mobile       : carousel full width, no sidebar, no promo
        md (768px+)  : sidebar (160px) + carousel
        xl (1280px+) : sidebar (200px) + carousel + promo cards (220px)
    -->
    <section class="flex mb-1.5 items-stretch">

        <!-- CENTER: Hero Carousel — always visible -->
        <div class="relative rounded-[2rem] overflow-hidden shadow-2xl flex-1 min-w-0 self-stretch min-h-[400px] group" id="hero-carousel">
            
            <!-- Slide 1: Newest Product -->
            @if (newest != null)
            {
                var mainImg = newest.HinhAnhSanPhams?.FirstOrDefault(h => h.AnhChinh);
                var imgUrl = mainImg != null ? HinhAnh.GetImageUrl(mainImg.DuongDanAnh, true) : "/Content/Images/no-image.png";
                
                <div class="hero-slide active absolute inset-0 flex items-center justify-between text-white overflow-hidden transition-all duration-700 cursor-pointer"
                     style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);"
                     onclick="location.href='@Url.Action("ChiTiet", "SanPham", new { id = newest.MaSanPham })'">
                    
                    <!-- Decorative effects -->
                    <div class="absolute top-[-20%] right-[-10%] w-96 h-96 bg-white/10 rounded-full blur-3xl animate-pulse"></div>
                    <div class="absolute bottom-[-10%] left-[-10%] w-80 h-80 bg-blue-500/20 rounded-full blur-3xl"></div>
                    
                    <div class="relative z-10 w-full h-full flex flex-col md:flex-row items-center justify-between px-8 md:px-16 py-6 gap-6">
                        <!-- Left text -->
                        <div class="flex-1 text-left space-y-4 max-w-xl">
                            <span class="inline-block bg-gradient-to-r from-red-500 to-orange-500 text-[10px] font-black px-4 py-1.5 rounded-full uppercase tracking-[0.2em] shadow-lg animate-bounce">
                                ✨ SIÊU PHẨM MỚI NHẤT
                            </span>
                            <h2 class="text-3xl sm:text-5xl font-black leading-tight tracking-tight drop-shadow-md line-clamp-2">
                                @newest.TenSanPham
                            </h2>
                            <p class="text-xs sm:text-sm text-blue-100 opacity-90 uppercase tracking-widest font-medium">
                                Thương hiệu cao cấp | Vừa lên kệ hôm nay
                            </p>
                            
                            <div class="flex items-center gap-4">
                                <div class="bg-white/15 backdrop-blur-md border border-white/20 px-6 py-2.5 rounded-2xl">
                                    <div class="text-[9px] font-bold text-blue-200 uppercase tracking-widest">Giá mở bán</div>
                                    <div class="text-2xl font-black text-white">@(newest.GiaBan > 0 ? newest.GiaBan.ToString("N0") + "₫" : "Liên hệ")</div>
                                </div>
                                @if (newest.GiaBan > 1000000)
                                {
                                    <div class="text-left">
                                        <div class="text-[10px] text-blue-200 line-through">@((newest.GiaBan * 1.2m).ToString("N0"))₫</div>
                                        <div class="text-xs font-black text-amber-300">TIẾT KIỆM 20%</div>
                                    </div>
                                }
                            </div>
                            
                            <div class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-900 rounded-xl font-black text-xs uppercase tracking-widest shadow-xl hover:bg-slate-100 transition-all">
                                Xem chi tiết & đặt mua <i class="fa fa-arrow-right"></i>
                            </div>
                        </div>
                        
                        <!-- Right image -->
                        <div class="flex-shrink-0 w-48 h-48 sm:w-80 sm:h-80 flex items-center justify-center bg-white/10 backdrop-blur-md border border-white/20 p-6 rounded-[2.5rem] shadow-2xl relative group-hover:scale-105 transition-transform duration-700">
                            <img src="@imgUrl" alt="@newest.TenSanPham" class="max-h-full max-w-full object-contain filter drop-shadow-[0_15px_15px_rgba(0,0,0,0.3)]" />
                        </div>
                    </div>
                </div>
            }

            <!-- Slide 2: Best Seller (Ultra configuration specs) -->
            @if (bestSeller != null)
            {
                var mainImg = bestSeller.HinhAnhSanPhams?.FirstOrDefault(h => h.AnhChinh);
                var imgUrl = mainImg != null ? HinhAnh.GetImageUrl(mainImg.DuongDanAnh, true) : "/Content/Images/no-image.png";
                
                <div class="hero-slide absolute inset-0 flex items-center justify-between text-white overflow-hidden transition-all duration-700 cursor-pointer"
                     style="background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);"
                     onclick="location.href='@Url.Action("ChiTiet", "SanPham", new { id = bestSeller.MaSanPham })'">
                    
                    <!-- Tech grid elements -->
                    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(#fff 0.5px, transparent 0.5px); background-size: 20px 20px;"></div>
                    <div class="absolute top-10 right-10 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl"></div>
                    <div class="absolute bottom-[-10%] left-10 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl"></div>
                    
                    <div class="relative z-10 w-full h-full flex flex-col md:flex-row items-center justify-between px-8 md:px-16 py-6 gap-6">
                        <!-- Left text -->
                        <div class="flex-1 text-left space-y-4 max-w-xl">
                            <span class="inline-flex items-center gap-1.5 bg-gradient-to-r from-emerald-500 to-cyan-500 text-[10px] font-black px-4 py-1.5 rounded-full uppercase tracking-[0.2em] shadow-lg">
                                <i class="fa fa-fire text-amber-300"></i> BÁN CHẠY NHẤT HỆ THỐNG
                            </span>
                            <h2 class="text-3xl sm:text-5xl font-black leading-tight tracking-tight drop-shadow-md line-clamp-2">
                                @bestSeller.TenSanPham
                            </h2>
                            
                            <!-- Dynamic specifications block -->
                            <div class="grid grid-cols-2 gap-2 max-w-md bg-white/5 backdrop-blur-md border border-white/10 p-4 rounded-2xl">
                                @if (!string.IsNullOrEmpty(bestSeller.ThongSoKyThuat))
                                {
                                    var specs = bestSeller.ThongSoKyThuat.Split(new[] { '\n', '\r', ';', '|' }, StringSplitOptions.RemoveEmptyEntries);
                                    int count = 0;
                                    foreach (var spec in specs.Take(4))
                                    {
                                        count++;
                                        string icon = "fa-circle-check";
                                        if (spec.ToLower().Contains("ram") || spec.ToLower().Contains("gb")) { icon = "fa-microchip"; }
                                        else if (spec.ToLower().Contains("ssd") || spec.ToLower().Contains("tb") || spec.ToLower().Contains("ổ cứng")) { icon = "fa-hard-drive"; }
                                        else if (spec.ToLower().Contains("rtx") || spec.ToLower().Contains("card") || spec.ToLower().Contains("đồ họa")) { icon = "fa-gamepad"; }
                                        else if (spec.ToLower().Contains("màn hình") || spec.ToLower().Contains("inch") || spec.ToLower().Contains("hz")) { icon = "fa-desktop"; }
                                        
                                        <div class="flex items-center gap-2 text-xs font-bold text-slate-200">
                                            <i class="fa @icon text-emerald-400 flex-shrink-0 text-[10px]"></i>
                                            <span class="truncate">@spec.Trim()</span>
                                        </div>
                                    }
                                    if (count < 4)
                                    {
                                        for (int i = count; i < 4; i++)
                                        {
                                            <div class="flex items-center gap-2 text-xs font-bold text-slate-300">
                                                <i class="fa fa-shield-halved text-cyan-400 flex-shrink-0 text-[10px]"></i>
                                                <span class="truncate">Chính hãng 100%</span>
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <div class="flex items-center gap-2 text-xs font-bold text-slate-200">
                                        <i class="fa fa-microchip text-emerald-400 flex-shrink-0"></i>
                                        <span>Cấu hình đỉnh cao</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-xs font-bold text-slate-200">
                                        <i class="fa fa-gamepad text-cyan-400 flex-shrink-0"></i>
                                        <span>Đồ họa siêu mượt</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-xs font-bold text-slate-200">
                                        <i class="fa fa-hard-drive text-amber-400 flex-shrink-0"></i>
                                        <span>Tốc độ phản hồi cực nhanh</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-xs font-bold text-slate-200">
                                        <i class="fa fa-shield text-red-400 flex-shrink-0"></i>
                                        <span>Bảo hành 24 tháng</span>
                                    </div>
                                }
                            </div>
                            
                            <div class="flex items-center gap-4">
                                <div class="text-2xl font-black text-emerald-400">@(bestSeller.GiaBan > 0 ? bestSeller.GiaBan.ToString("N0") + "₫" : "Liên hệ")</div>
                                <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-widest">
                                    HIỆU NĂNG KHỦNG
                                </span>
                            </div>
                        </div>
                        
                        <!-- Right image -->
                        <div class="flex-shrink-0 w-48 h-48 sm:w-80 sm:h-80 flex items-center justify-center bg-white/10 backdrop-blur-md border border-white/20 p-6 rounded-[2.5rem] shadow-2xl relative">
                            <img src="@imgUrl" alt="@bestSeller.TenSanPham" class="max-h-full max-w-full object-contain filter drop-shadow-[0_15px_15px_rgba(0,0,0,0.5)]" />
                        </div>
                    </div>
                </div>
            }

            <!-- Slide 3: Featured Product (Luxury Highlight) -->
            @if (featured != null)
            {
                var mainImg = featured.HinhAnhSanPhams?.FirstOrDefault(h => h.AnhChinh);
                var imgUrl = mainImg != null ? HinhAnh.GetImageUrl(mainImg.DuongDanAnh, true) : "/Content/Images/no-image.png";
                
                <div class="hero-slide absolute inset-0 flex items-center justify-between text-white overflow-hidden transition-all duration-700 cursor-pointer"
                     style="background: radial-gradient(circle at top right, #f857a6 0%, #ff5858 100%);"
                     onclick="location.href='@Url.Action("ChiTiet", "SanPham", new { id = featured.MaSanPham })'">
                    
                    <!-- Sparkle / Fire decorative elements -->
                    <div class="absolute top-[-30%] left-[-10%] w-full h-full bg-yellow-500/10 rounded-full blur-[120px]"></div>
                    <div class="absolute bottom-0 right-10 w-96 h-96 bg-red-600/10 rounded-full blur-3xl"></div>
                    
                    <div class="relative z-10 w-full h-full flex flex-col md:flex-row items-center justify-between px-8 md:px-16 py-6 gap-6">
                        <!-- Left text -->
                        <div class="flex-1 text-left space-y-4 max-w-xl">
                            <span class="inline-block bg-white/20 backdrop-blur-md border border-white/30 text-[10px] font-black px-4 py-1 rounded-full uppercase tracking-[0.2em] shadow-lg">
                                💎 SIÊU KHUYẾN MÃI - BÁN CHẠY
                            </span>
                            <h2 class="text-3xl sm:text-5xl font-black leading-tight tracking-tight drop-shadow-md line-clamp-2">
                                @featured.TenSanPham
                            </h2>
                            <p class="text-xs sm:text-sm text-yellow-100 font-medium uppercase tracking-widest">
                                Cam kết giá rẻ nhất thị trường | Hoàn tiền 200% nếu phát hiện giả mạo
                            </p>
                            
                            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-6 rounded-[2rem] relative overflow-hidden max-w-md">
                                <div class="flex items-center justify-between gap-6">
                                    <div>
                                        <div class="text-[9px] text-yellow-200 font-black uppercase tracking-widest">Giá ưu đãi đặc biệt</div>
                                        <div class="text-3xl font-black text-white">@(featured.GiaBan > 0 ? featured.GiaBan.ToString("N0") + "₫" : "Liên hệ")</div>
                                    </div>
                                    <div class="w-px h-10 bg-white/20"></div>
                                    <div>
                                        <div class="text-[9px] text-yellow-200 font-black uppercase tracking-widest">Bảo hành vàng</div>
                                        <div class="text-lg font-black text-white">1 ĐỔI 1 TRONG 30 NGÀY</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Right image -->
                        <div class="flex-shrink-0 w-48 h-48 sm:w-80 sm:h-80 flex items-center justify-center bg-white/10 backdrop-blur-md border border-white/20 p-6 rounded-[2.5rem] shadow-2xl relative">
                            <img src="@imgUrl" alt="@featured.TenSanPham" class="max-h-full max-w-full object-contain filter drop-shadow-[0_15px_15px_rgba(0,0,0,0.4)]" />
                        </div>
                    </div>
                </div>
            }

            <!-- Carousel Controls -->
            <button id="carousel-prev" class="absolute left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-slate-900 transition-all z-20 shadow-xl opacity-0 group-hover:opacity-100">
                <i class="fa fa-chevron-left"></i>
            </button>
            <button id="carousel-next" class="absolute right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-slate-900 transition-all z-20 shadow-xl opacity-0 group-hover:opacity-100">
                <i class="fa fa-chevron-right"></i>
            </button>
            
            <!-- Indicators -->
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-3 z-20">
                <div class="dot w-8 h-1.5 rounded-full bg-white cursor-pointer transition-all duration-500" data-index="0"></div>
                <div class="dot w-3 h-1.5 rounded-full bg-white/30 cursor-pointer transition-all duration-500" data-index="1"></div>
                <div class="dot w-3 h-1.5 rounded-full bg-white/30 cursor-pointer transition-all duration-500" data-index="2"></div>
            </div>
        </div>
    </section>

    <!-- ===================== CAM KẾT CHẤT LƯỢNG BAR ===================== -->
    <div class="bg-gradient-to-r from-red-600 to-rose-500 rounded-[1.25rem] px-6 flex items-center justify-between gap-4 mb-4 h-12 shadow-lg shadow-red-500/10 overflow-hidden text-white">
        <div class="flex items-center gap-2 font-black text-sm uppercase tracking-wider">
            <i class="fa fa-shield-halved text-amber-300 text-lg"></i>
            <span>DỊCH VỤ VÀNG TẠI VUONGDIENTU</span>
        </div>
        
        <div class="hidden lg:flex items-center gap-6 text-[11px] font-bold tracking-wide">
            <div class="flex items-center gap-1.5 text-rose-100">
                <i class="fa fa-circle-check text-amber-300"></i>
                <span>100% CHÍNH HÃNG</span>
            </div>
            <span class="text-white/20">|</span>
            <div class="flex items-center gap-1.5 text-rose-100">
                <i class="fa fa-truck-fast text-amber-300"></i>
                <span>GIAO HÀNG HỎA TỐC</span>
            </div>
            <span class="text-white/20">|</span>
            <div class="flex items-center gap-1.5 text-rose-100">
                <i class="fa fa-screwdriver-wrench text-amber-300"></i>
                <span>BẢO HÀNH ĐỘC QUYỀN 2 NĂM</span>
            </div>
            <span class="text-white/20">|</span>
            <div class="flex items-center gap-1.5 text-rose-100">
                <i class="fa fa-rotate text-amber-300"></i>
                <span>1 ĐỔI 1 TRONG 30 NGÀY</span>
            </div>
        </div>
        
        <a href="javascript:void(0)" id="btn-showroom-map" class="bg-white/20 hover:bg-white hover:text-red-600 border border-white/30 text-white font-black text-[11px] tracking-wider uppercase whitespace-nowrap px-4 py-2 rounded-xl flex items-center gap-1.5 shadow-md transition-all active:scale-95">
            <i class="fa fa-map-marker-alt text-[13px]"></i> Mua trực tiếp tại cửa hàng
        </a>
    </div>

    <!-- ===================== SAN PHAM NOI BAT ===================== -->
    <h2 class="flex items-center gap-2 text-base sm:text-lg font-black text-gray-800 mb-3">
        <span class="w-1 h-5 bg-primary rounded inline-block"></span>
        Sản Phẩm Nổi Bật
    </h2>

    @Html.Action("SanPhamNoiBat", "SanPham")

    <!-- ===================== SAN PHAM BAN CHAY ===================== -->
    @Html.Action("SanPhamBanChay", "SanPham")
</div>

<!-- Showroom Map Modal -->
<div id="showroom-map-modal" class="fixed inset-0 z-[9999] hidden flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-4xl overflow-hidden border border-slate-100 relative">
        <!-- Modal Header -->
        <div class="px-8 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 bg-red-50 text-red-600 rounded-full text-[9px] font-black uppercase tracking-wider">Showroom</span>
                <h3 class="text-lg font-black text-slate-800 uppercase italic">Bản đồ cửa hàng</h3>
            </div>
            <button type="button" id="btn-close-map-modal" class="w-8 h-8 rounded-full bg-slate-200/60 text-slate-600 hover:bg-slate-200 hover:text-slate-800 transition-colors flex items-center justify-center">
                <i class="fa fa-times text-sm"></i>
            </button>
        </div>
        <!-- Modal Body -->
        <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                <div class="md:col-span-5 space-y-4">
                    <h4 class="text-xl font-black text-slate-800 italic uppercase">Ghé Thăm Cửa Hàng</h4>
                    <p class="text-xs text-slate-500 font-medium leading-relaxed italic">Trải nghiệm trực tiếp và nhận thêm hàng loạt ưu đãi hấp dẫn chỉ có tại cửa hàng.</p>
                    <div class="space-y-3 pt-2 text-xs">
                        <div class="flex items-start gap-2">
                            <i class="fa fa-map-marker-alt text-red-600 w-4 text-center mt-0.5 animate-bounce"></i>
                            <div>
                                <p class="font-bold text-slate-400 uppercase tracking-widest text-[9px]">Địa chỉ</p>
                                <p class="font-black text-slate-800">@config.StoreAddress</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-2">
                            <i class="fa fa-phone text-red-600 w-4 text-center mt-0.5"></i>
                            <div>
                                <p class="font-bold text-slate-400 uppercase tracking-widest text-[9px]">Hotline</p>
                                <p class="font-black text-slate-800">@config.StoreHotline (Miễn phí)</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-2">
                            <i class="fa fa-clock text-red-600 w-4 text-center mt-0.5"></i>
                            <div>
                                <p class="font-bold text-slate-400 uppercase tracking-widest text-[9px]">Giờ mở cửa</p>
                                <p class="font-black text-slate-800">@config.StoreWorkingHours</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="md:col-span-7 h-[300px] rounded-2xl overflow-hidden border border-slate-100 shadow-inner relative">
                    <iframe 
                        src="@VuongBanDienTu.Helpers.CauHinhHelper.LayLinkMapEmbed(config.StoreMapEmbed)" 
                        width="100%" 
                        height="100%" 
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade"
                        class="w-full h-full">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
(function () {
    var slides = document.querySelectorAll('.hero-slide');
    var dots   = document.querySelectorAll('.dot');
    var current = 0, timer;

    function goTo(idx) {
        slides[current].classList.remove('active');
        current = (idx + slides.length) % slides.length;
        slides[current].classList.add('active');
        
        // Dynamically toggle width and opacity classes for dots to animate active state
        dots.forEach(function (dot, i) {
            if (i === current) {
                dot.classList.add('w-8', 'bg-white');
                dot.classList.remove('w-3', 'bg-white/30');
            } else {
                dot.classList.add('w-3', 'bg-white/30');
                dot.classList.remove('w-8', 'bg-white');
            }
        });
    }

    function startAuto() { timer = setInterval(function(){ goTo(current + 1); }, 4000); }

    document.getElementById('carousel-next').addEventListener('click', function () { clearInterval(timer); goTo(current + 1); startAuto(); });
    document.getElementById('carousel-prev').addEventListener('click', function () { clearInterval(timer); goTo(current - 1); startAuto(); });
    dots.forEach(function (dot) {
        dot.addEventListener('click', function () { clearInterval(timer); goTo(+this.dataset.index); startAuto(); });
    });
    startAuto();
    
    // Showroom map modal toggles
    var mapModal = document.getElementById('showroom-map-modal');
    var btnShowMap = document.getElementById('btn-showroom-map');
    var btnCloseMap = document.getElementById('btn-close-map-modal');

    if (btnShowMap && mapModal) {
        btnShowMap.addEventListener('click', function(e) {
            e.preventDefault();
            mapModal.classList.remove('hidden');
            mapModal.classList.add('flex');
        });
    }

    if (btnCloseMap && mapModal) {
        btnCloseMap.addEventListener('click', function() {
            mapModal.classList.add('hidden');
            mapModal.classList.remove('flex');
        });
    }

    if (mapModal) {
        mapModal.addEventListener('click', function(e) {
            if (e.target === mapModal) {
                mapModal.classList.add('hidden');
                mapModal.classList.remove('flex');
            }
        });
    }
})();</script>
}