@model IEnumerable<VuongBanDienTu.Models.SanPham>
@{
    ViewBag.Title = "Trang chủ";
}

<div class="max-w-screen-xl mx-auto px-3 pt-1.5 pb-3">

    <!-- ===================== HERO SECTION ===================== -->
    <!--
        Breakpoints:
        mobile       : carousel full width, no sidebar, no promo
        md (768px+)  : sidebar (160px) + carousel
        xl (1280px+) : sidebar (200px) + carousel + promo cards (220px)
    -->
    <section class="flex gap-2 mb-1.5 items-stretch">

        <!-- LEFT: Category Sidebar — hidden on mobile, shown md+ -->
        <aside class="hidden md:flex flex-col bg-white rounded-lg overflow-hidden shadow-sm flex-shrink-0 w-40 xl:w-52">
            <ul class="flex-1">
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (IEnumerable<VuongBanDienTu.Models.DanhMuc>)ViewBag.Categories)
                    {
                        <li class="cat-item border-b border-gray-100 transition-colors hover:bg-red-50 hover:text-primary">
                            <a href="@Url.Action("Index", "SanPham", new { id = cat.MaDanhMuc })" class="flex items-center justify-between px-3 py-1.5 text-xs cursor-pointer">
                                <span class="flex items-center gap-1.5 min-w-0">
                                    <i class="fa fa-chevron-right text-primary w-3 flex-shrink-0 text-[8px]"></i>
                                    <span class="truncate">@cat.TenDanhMuc</span>
                                </span>
                                <i class="fa fa-chevron-right text-gray-400 text-[9px] flex-shrink-0 ml-1"></i>
                            </a>
                        </li>
                    }
                }
                else
                {
                    <li class="px-3 py-4 text-center text-[10px] text-slate-400">Đang cập nhật...</li>
                }
            </ul>
        </aside>

        <!-- CENTER: Hero Carousel — always visible -->
        <div class="relative rounded-[2rem] overflow-hidden shadow-2xl flex-1 min-w-0 self-stretch min-h-[400px] group" id="hero-carousel">
            
            <!-- Slide 1: Modern Kitchen -->
            <div class="hero-slide active absolute inset-0 flex items-center justify-center text-white overflow-hidden transition-all duration-700"
                 style="background: radial-gradient(circle at top right, #ff9a9e, #fecfef); ">
                <!-- Decorative elements -->
                <div class="absolute top-[-10%] right-[-10%] w-80 h-80 bg-white/20 rounded-full blur-3xl animate-pulse"></div>
                <div class="absolute bottom-[-20%] left-[-10%] w-96 h-96 bg-orange-500/20 rounded-full blur-3xl"></div>
                
                <div class="relative z-10 text-center px-8 w-full max-w-2xl scale-95 group-hover:scale-100 transition-transform duration-1000">
                    <span class="inline-block bg-white/20 backdrop-blur-md border border-white/30 text-[10px] font-black px-5 py-1.5 rounded-full mb-6 uppercase tracking-[0.3em] shadow-xl text-orange-900">Gia dụng cao cấp</span>
                    <h2 class="text-4xl sm:text-6xl font-black leading-none mb-4 drop-shadow-lg tracking-tighter italic text-orange-800">BẾP XINH <span class="text-red-600">SANG</span><br/>NẤU ĂN <span class="text-red-600">NGON</span></h2>
                    <p class="text-sm font-medium text-orange-900 opacity-80 mb-8 uppercase tracking-widest">Ưu đãi đến 40% cho Combo thiết bị bếp</p>
                    
                    <div class="flex gap-4 justify-center">
                        <div class="bg-white/40 backdrop-blur-xl border border-white/40 p-4 rounded-3xl w-40 text-left shadow-2xl transform -rotate-2 hover:rotate-0 transition-all duration-500">
                            <div class="text-[9px] font-black text-red-600 uppercase mb-1">Top Selling</div>
                            <div class="text-xs font-bold leading-tight line-clamp-2 mb-2 text-slate-800">Nồi cơm điện cao tần Toshiba</div>
                            <div class="text-xl font-black text-red-600">2.490K</div>
                        </div>
                        <div class="bg-white/40 backdrop-blur-xl border border-white/40 p-4 rounded-3xl w-40 text-left shadow-2xl transform rotate-2 hover:rotate-0 transition-all duration-500 hidden sm:block">
                            <div class="text-[9px] font-black text-red-600 uppercase mb-1">New Arrival</div>
                            <div class="text-xs font-bold leading-tight line-clamp-2 mb-2 text-slate-800">Bếp từ đôi hồng ngoại Sunhouse</div>
                            <div class="text-xl font-black text-red-600">5.890K</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2: Cooling System -->
            <div class="hero-slide absolute inset-0 flex items-center justify-center text-white overflow-hidden transition-all duration-700"
                 style="background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);">
                <!-- Water bubble effects -->
                <div class="absolute top-20 left-20 w-32 h-32 bg-white/40 rounded-full blur-2xl animate-bounce" style="animation-duration: 3s"></div>
                <div class="absolute bottom-10 right-40 w-48 h-48 bg-white/30 rounded-full blur-2xl animate-bounce" style="animation-duration: 5s"></div>
                
                <div class="relative z-10 text-center px-8 w-full max-w-2xl">
                    <div class="inline-flex items-center gap-2 bg-blue-600/10 backdrop-blur-md px-4 py-1.5 rounded-full mb-6 border border-blue-200">
                        <i class="fa fa-snowflake text-blue-500 animate-spin" style="animation-duration: 5s"></i>
                        <span class="text-[10px] font-black uppercase tracking-widest text-blue-700">Mùa hè mát lạnh 2026</span>
                    </div>
                    <h2 class="text-4xl sm:text-6xl font-black leading-none mb-4 drop-shadow-xl italic tracking-tighter text-blue-900">MÁY LẠNH <span class="text-blue-600">INVERTER</span><br/><span class="text-blue-500">GIẢM 2 TRIỆU</span></h2>
                    <p class="text-sm font-medium text-blue-800 opacity-90 mb-10 uppercase tracking-widest">Miễn phí lắp đặt & Tặng ống đồng 5m</p>
                    
                    <a href="@Url.Action("Index", "SanPham")" class="px-10 py-4 bg-blue-600 text-white rounded-2xl font-black uppercase text-xs tracking-[0.2em] shadow-2xl hover:bg-blue-700 active:scale-95 transition-all">Săn ngay Deal giải nhiệt</a>
                </div>
            </div>

            <!-- Slide 3: Washing & Care -->
            <div class="hero-slide absolute inset-0 flex items-center justify-center text-white overflow-hidden transition-all duration-700"
                 style="background: linear-gradient(to bottom right, #134e5e, #71b280);">
                <!-- Abstract leaf/nature elements -->
                <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#fff 0.5px, transparent 0.5px); background-size: 25px 25px;"></div>
                <div class="absolute top-[-20%] left-[-10%] w-full h-full bg-emerald-500/10 rounded-full blur-[100px]"></div>
                
                <div class="relative z-10 text-center px-8 w-full max-w-2xl">
                    <h2 class="text-5xl sm:text-7xl font-black leading-none mb-6 drop-shadow-2xl italic">
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-cyan-300">CLEAN</span><br/><span class="text-white">LIVING</span>
                    </h2>
                    <div class="bg-white/5 backdrop-blur-xl border border-white/10 p-8 rounded-[2.5rem] relative overflow-hidden group">
                        <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/10 to-cyan-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <p class="text-sm font-bold text-emerald-200 uppercase tracking-[0.4em] mb-4">Sạch thơm tinh tươm - Tiết kiệm điện nước</p>
                        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
                            <div class="text-center">
                                <div class="text-[10px] text-emerald-300 font-black uppercase">Máy giặt sấy</div>
                                <div class="text-2xl font-black">GIẢM 30%</div>
                            </div>
                            <div class="w-px h-10 bg-white/10 hidden sm:block"></div>
                            <div class="text-center">
                                <div class="text-[10px] text-cyan-300 font-black uppercase">Tủ lạnh Multi-door</div>
                                <div class="text-2xl font-black">TRẢ GÓP 0%</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Carousel Controls -->
            <button id="carousel-prev" class="absolute left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-slate-900 transition-all z-20 shadow-xl opacity-0 group-hover:opacity-100">
                <i class="fa fa-chevron-left"></i>
            </button>
            <button id="carousel-next" class="absolute right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-slate-900 transition-all z-20 shadow-xl opacity-0 group-hover:opacity-100">
                <i class="fa fa-chevron-right"></i>
            </button>
            
            <!-- Indicators -->
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-3 z-20">
                <div class="dot w-8 h-1.5 rounded-full bg-white cursor-pointer transition-all duration-500" data-index="0"></div>
                <div class="dot w-3 h-1.5 rounded-full bg-white/30 cursor-pointer transition-all duration-500" data-index="1"></div>
                <div class="dot w-3 h-1.5 rounded-full bg-white/30 cursor-pointer transition-all duration-500" data-index="2"></div>
            </div>
        </div>

        <!-- RIGHT: Promo Cards — only xl (1280px+) -->
        <div class="hidden xl:flex flex-col gap-2 w-52 flex-shrink-0">

            <a href="#" class="flex-1 bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-3 flex flex-col items-center justify-center text-center hover:-translate-y-0.5 hover:shadow-md transition-all">
                <i class="fa fa-snowflake text-2xl text-blue-500 mb-1"></i>
                <div class="text-[11px] font-black text-primary leading-tight uppercase">MÁY LẠNH ƯU ĐÃI ĐỘC QUYỀN</div>
                <div class="text-[10px] text-gray-500 my-1">HIC09TMU</div>
                <div class="text-base font-black text-navy">Funiki</div>
                <span class="mt-1 bg-primary text-white text-[10px] font-bold px-3 py-0.5 rounded-full">Xem ngay</span>
            </a>

            <a href="#" class="flex-1 bg-gradient-to-br from-red-50 to-orange-100 rounded-xl p-3 flex flex-col items-center justify-center text-center hover:-translate-y-0.5 hover:shadow-md transition-all">
                <i class="fa fa-percent text-2xl text-primary mb-1"></i>
                <div class="text-xl font-black text-primary uppercase">GIẢM 5%</div>
                <div class="text-[10px] text-gray-500 mt-1 leading-snug">Khi mua từ 2 sản phẩm gia dụng<br/>Tới 500K giặt sấy</div>
                <span class="mt-1.5 bg-primary text-white text-[10px] font-bold px-3 py-0.5 rounded-full">Áp dụng ngay</span>
            </a>

            <a href="#" class="flex-1 bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-xl p-3 flex flex-col items-center justify-center text-center hover:-translate-y-0.5 hover:shadow-md transition-all">
                <i class="fa fa-gift text-2xl text-yellow-500 mb-1"></i>
                <div class="text-[11px] font-black text-primary uppercase">Đón Vượng Khí</div>
                <div class="text-[10px] text-gray-500">Quà tặng lên đến</div>
                <div class="text-3xl font-black text-primary leading-none">3<span class="text-lg">M</span></div>
                <span class="mt-1 bg-primary text-white text-[10px] font-bold px-3 py-0.5 rounded-full">Nhận ngay</span>
            </a>

        </div>
    </section>

    <!-- Promo cards strip — shown on md and lg (when right sidebar is hidden) -->
    <div class="flex gap-2 mb-1.5 xl:hidden overflow-x-auto scrollbar-hide min-w-0">
        <a href="#" class="flex-1 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-2.5 flex items-center gap-2 hover:shadow-md transition-all">
            <i class="fa fa-snowflake text-xl text-blue-500"></i>
            <div>
                <div class="text-xs font-black text-primary">MÁY LẠNH ƯU ĐÃI</div>
                <div class="text-[10px] text-gray-500">Funiki HIC09TMU</div>
            </div>
        </a>
        <a href="#" class="flex-1 bg-gradient-to-br from-red-50 to-orange-100 rounded-lg p-2.5 flex items-center gap-2 hover:shadow-md transition-all">
            <i class="fa fa-percent text-xl text-primary"></i>
            <div>
                <div class="text-xs font-black text-primary uppercase">GIẢM 5%</div>
                <div class="text-[10px] text-gray-500">Mua từ 2 sản phẩm</div>
            </div>
        </a>
        <a href="#" class="flex-1 bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-lg p-2.5 flex items-center gap-2 hover:shadow-md transition-all">
            <i class="fa fa-gift text-xl text-yellow-500"></i>
            <div>
                <div class="text-xs font-black text-primary">QUÀ TẶNG 3 TRIỆU</div>
                <div class="text-[10px] text-gray-500 uppercase">Đón Vượng Khí</div>
            </div>
        </a>
    </div>

    <!-- ===================== FLASH SALE BAR ===================== -->
    <div class="bg-primary rounded-xl px-4 flex items-center gap-3 mb-2 h-12 shadow-md shadow-red-300/40 overflow-hidden">
        <div class="flex items-center gap-2 text-white font-black text-base sm:text-lg uppercase whitespace-nowrap">
            <i class="fa fa-bolt text-gold text-lg"></i>
            <span>FLASH SALE</span>
        </div>
        <span class="text-white/40 text-lg hidden sm:block">|</span>
        <span class="text-white/90 text-xs font-semibold whitespace-nowrap hidden sm:block">GIÁ CỰC SỐC</span>
        <div class="flex items-center gap-1 ml-2">
            <div class="bg-white text-primary font-black text-sm w-8 h-7 rounded flex items-center justify-center" id="t-h">09</div>
            <span class="text-white font-black">:</span>
            <div class="bg-white text-primary font-black text-sm w-8 h-7 rounded flex items-center justify-center" id="t-m">59</div>
            <span class="text-white font-black">:</span>
            <div class="bg-white text-primary font-black text-sm w-8 h-7 rounded flex items-center justify-center" id="t-s">59</div>
        </div>
        <a href="@Url.Action("Index", "SanPham", new { id = "" })" class="ml-auto text-white/90 hover:text-white text-xs font-semibold whitespace-nowrap flex items-center gap-1">
            Xem thêm <i class="fa fa-chevron-right text-[9px]"></i>
        </a>
    </div>


    <!-- ===================== SAN PHAM NOI BAT ===================== -->
    <h2 class="flex items-center gap-2 text-base sm:text-lg font-black text-gray-800 mb-3">
        <span class="w-1 h-5 bg-primary rounded inline-block"></span>
        Sản Phẩm Nổi Bật
    </h2>

    @Html.Action("SanPhamNoiBat", "SanPham")

    <!-- ===================== SAN PHAM BAN CHAY ===================== -->
    @Html.Action("SanPhamBanChay", "SanPham")
</div>

@section scripts {
<script>
(function () {
    var slides = document.querySelectorAll('.hero-slide');
    var dots   = document.querySelectorAll('.dot');
    var current = 0, timer;

    function goTo(idx) {
        slides[current].classList.remove('active');
        dots[current].classList.replace('bg-white', 'bg-white/40');
        current = (idx + slides.length) % slides.length;
        slides[current].classList.add('active');
        dots[current].classList.replace('bg-white/40', 'bg-white');
    }

    function startAuto() { timer = setInterval(function(){ goTo(current + 1); }, 4000); }

    document.getElementById('carousel-next').addEventListener('click', function () { clearInterval(timer); goTo(current + 1); startAuto(); });
    document.getElementById('carousel-prev').addEventListener('click', function () { clearInterval(timer); goTo(current - 1); startAuto(); });
    dots.forEach(function (dot) {
        dot.addEventListener('click', function () { clearInterval(timer); goTo(+this.dataset.index); startAuto(); });
    });
    startAuto();
})();

(function () {
    var end = new Date(Date.now() + 9*3600000 + 59*60000 + 59000);
    function pad(n){ return (n<10?'0':'')+n; }
    function tick(){
        var d = Math.max(0, Math.floor((end - Date.now()) / 1000));
        document.getElementById('t-h').textContent = pad(Math.floor(d/3600));
        document.getElementById('t-m').textContent = pad(Math.floor((d%3600)/60));
        document.getElementById('t-s').textContent = pad(d%60);
        if(d>0) setTimeout(tick, 1000);
    }
    tick();
})();
</script>
}