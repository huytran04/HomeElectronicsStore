@{
    ViewBag.Title = "Bán hàng doanh nghiệp";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var config = VuongBanDienTu.Helpers.CauHinhHelper.LayCauHinh();
}

<div class="max-w-screen-xl mx-auto px-4 py-12">
    <div class="bg-slate-900 rounded-[3rem] p-12 md:p-20 text-white relative overflow-hidden mb-12">
        <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(#fff 0.5px, transparent 0.5px); background-size: 30px 30px;"></div>
        <div class="relative z-10 text-center max-w-3xl mx-auto">
            <h1 class="text-4xl md:text-6xl font-black italic tracking-tighter uppercase mb-6 leading-none">
                Giải Pháp <span class="text-emerald-400">Thiết Bị</span><br/>Dành Cho Doanh Nghiệp
            </h1>
            <p class="text-lg text-slate-300 font-medium mb-10 leading-relaxed italic">Vương Điện Tử tự hào là đối tác cung cấp thiết bị gia dụng, điện lạnh cho hơn 500+ dự án chung cư, văn phòng và nhà hàng trên toàn quốc.</p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="tel:@config.StoreHotline" class="px-10 py-4 border-2 border-white/20 rounded-full font-black uppercase text-sm hover:bg-white/10 transition-all">Hotline B2B: @config.StoreHotline</a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-lg text-center">
            <div class="text-3xl text-emerald-500 mb-4 italic font-black">01.</div>
            <h4 class="font-bold text-slate-800 mb-2 uppercase italic">Chiết khấu cao</h4>
            <p class="text-xs text-slate-500 italic">Mức giá cạnh tranh nhất cho các đơn hàng số lượng lớn và dự án.</p>
        </div>
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-lg text-center">
            <div class="text-3xl text-emerald-500 mb-4 italic font-black">02.</div>
            <h4 class="font-bold text-slate-800 mb-2 uppercase italic">Hỗ trợ 24/7</h4>
            <p class="text-xs text-slate-500 italic">Nhân viên kinh doanh riêng biệt hỗ trợ mọi lúc, mọi nơi.</p>
        </div>
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-lg text-center">
            <div class="text-3xl text-emerald-500 mb-4 italic font-black">03.</div>
            <h4 class="font-bold text-slate-800 mb-2 uppercase italic">Vận chuyển</h4>
            <p class="text-xs text-slate-500 italic">Vận chuyển miễn phí toàn quốc, bốc xếp tận nơi công trình.</p>
        </div>
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-lg text-center">
            <div class="text-3xl text-emerald-500 mb-4 italic font-black">04.</div>
            <h4 class="font-bold text-slate-800 mb-2 uppercase italic">Hợp đồng</h4>
            <p class="text-xs text-slate-500 italic">Quy trình chuyên nghiệp, đầy đủ hóa đơn VAT và CO/CQ.</p>
        </div>
    </div>
</div>
