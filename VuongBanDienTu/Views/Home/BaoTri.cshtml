@model VuongBanDienTu.Helpers.CauHinhModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hệ thống đang bảo trì - @Model.StoreName</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#e8192c',
                        'primary-dark': '#c0001a',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="bg-slate-950 text-slate-100 flex items-center justify-center min-h-screen p-4 overflow-hidden relative">
    
    <!-- Background glowing decorative circles -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-red-600/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-md w-full text-center space-y-8 relative z-10">
        <!-- Brand -->
        <div class="text-3xl font-black italic tracking-tight text-white animate-pulse">
            <span class="text-yellow-400">VUONG</span>DIENTU
        </div>

        <!-- Maintenance Illustration / Gears -->
        <div class="relative w-32 h-32 mx-auto flex items-center justify-center">
            <i class="fa fa-cog text-6xl text-primary animate-spin duration-1000 w-16 h-16 flex items-center justify-center" style="animation-duration: 8s;"></i>
            <i class="fa fa-cog text-4xl text-slate-700 animate-spin w-12 h-12 absolute -top-1 -right-1" style="animation-direction: reverse; animation-duration: 5s;"></i>
            <i class="fa fa-wrench text-3xl text-yellow-500 absolute -bottom-1 left-2 rotate-12"></i>
        </div>

        <div class="space-y-3">
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white uppercase italic">Hệ thống đang bảo trì</h1>
            <p class="text-slate-400 text-sm leading-relaxed max-w-sm mx-auto font-medium">Chúng tôi đang thực hiện nâng cấp hệ thống định kỳ nhằm nâng cao chất lượng dịch vụ và bảo mật thông tin khách hàng.</p>
        </div>

        <div class="p-6 bg-slate-900/60 backdrop-blur border border-slate-800/80 rounded-3xl space-y-4 shadow-2xl">
            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest">Cần hỗ trợ khẩn cấp?</h3>
            <div class="grid grid-cols-2 gap-4">
                <a href="tel:@Model.StoreHotline" class="p-3 bg-primary/10 border border-primary/20 rounded-2xl flex flex-col items-center gap-1 hover:bg-primary/20 transition-all">
                    <i class="fa fa-phone text-primary text-base"></i>
                    <span class="text-[10px] font-bold text-slate-400 uppercase">Hotline</span>
                    <span class="text-xs font-black text-white">@Model.StoreHotline</span>
                </a>
                <a href="mailto:@Model.StoreEmail" class="p-3 bg-slate-800/50 border border-slate-800 rounded-2xl flex flex-col items-center gap-1 hover:bg-slate-800 transition-all truncate">
                    <i class="fa fa-envelope text-yellow-500 text-base"></i>
                    <span class="text-[10px] font-bold text-slate-400 uppercase">Email</span>
                    <span class="text-xs font-black text-white truncate block max-w-full">@Model.StoreEmail</span>
                </a>
            </div>
        </div>

        <div class="text-[10px] text-slate-500 font-bold uppercase tracking-widest pt-4">
            Cảm ơn quý khách đã thông cảm và kiên nhẫn!
        </div>

        <div class="pt-6 border-t border-slate-900/60 flex justify-center">
            <a href="/TaiKhoan/DangNhap" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-900 border border-slate-800/80 hover:border-primary/40 hover:bg-slate-800/50 rounded-2xl text-[10px] font-black uppercase tracking-wider text-slate-400 hover:text-white transition-all shadow-md active:scale-95">
                <i class="fa fa-lock-open text-primary"></i> Đăng nhập Quản trị
            </a>
        </div>
    </div>
</body>
</html>
