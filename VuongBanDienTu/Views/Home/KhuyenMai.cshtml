@{
    ViewBag.Title = "Tổng hợp khuyến mại";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-screen-xl mx-auto px-4 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-12">
        <div>
            <h1 class="text-4xl font-black italic text-slate-800 uppercase tracking-tighter">Đại Tiệc <span class="text-red-600">Ưu Đãi</span></h1>
            <p class="text-slate-500 font-medium">Đừng bỏ lỡ cơ hội sở hữu đồ gia dụng giá hời nhất</p>
        </div>
        <div class="flex gap-2">
            <span class="px-4 py-2 bg-red-600 text-white rounded-full text-xs font-bold animate-pulse">LIVE NOW</span>
            <span class="px-4 py-2 bg-slate-800 text-white rounded-full text-xs font-bold">MAY 2026</span>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- KM 1 -->
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-xl p-8 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-32 h-32 bg-red-600 text-white flex items-center justify-center font-black text-2xl rotate-45 translate-x-12 -translate-y-12">
                -40%
            </div>
            <div class="relative z-10">
                <h3 class="text-2xl font-black text-slate-800 mb-4 italic uppercase">Mùa Hè Rực Rỡ</h3>
                <p class="text-slate-600 mb-6 line-clamp-2 italic">Giảm sốc toàn bộ các dòng Máy lạnh, Quạt điều hòa, Máy lọc nước chính hãng.</p>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest italic">Hết hạn: 31/05/2026</span>
                    <button class="px-6 py-2 bg-slate-900 text-white rounded-full text-xs font-bold hover:bg-red-600 transition-colors uppercase">Xem chi tiết</button>
                </div>
            </div>
        </div>

        <!-- KM 2 -->
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-xl p-8 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-32 h-32 bg-gold text-slate-900 flex items-center justify-center font-black text-2xl rotate-45 translate-x-12 -translate-y-12">
                FREE
            </div>
            <div class="relative z-10">
                <h3 class="text-2xl font-black text-slate-800 mb-4 italic uppercase">Tân Gia Như Ý</h3>
                <p class="text-slate-600 mb-6 line-clamp-2 italic">Mua Combo Bếp + Hút mùi, tặng ngay Nồi chiên không dầu Lock&Lock 5.2L.</p>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest italic">Hết hạn: 15/06/2026</span>
                    <button class="px-6 py-2 bg-slate-900 text-white rounded-full text-xs font-bold hover:bg-gold hover:text-slate-900 transition-colors uppercase">Xem chi tiết</button>
                </div>
            </div>
        </div>

        <!-- KM 3 -->
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-xl p-8 relative overflow-hidden group md:col-span-2">
            <div class="flex flex-col md:flex-row items-center gap-8">
                <div class="flex-1">
                    <h3 class="text-3xl font-black text-slate-800 mb-4 italic uppercase tracking-tighter">Ngày Vàng Thành Viên</h3>
                    <p class="text-slate-600 mb-6 italic">Giảm thêm 2-5% cho khách hàng thân thiết. Nhân 2 điểm tích lũy vào mỗi thứ 7 và Chủ Nhật hàng tuần.</p>
                    <div class="flex items-center gap-4">
                        <button class="px-8 py-3 bg-red-600 text-white rounded-full font-black text-xs uppercase shadow-xl">Đăng ký thành viên ngay</button>
                    </div>
                </div>
                <div class="hidden md:block">
                    <div class="w-40 h-40 rounded-full bg-slate-50 border-4 border-white shadow-inner flex items-center justify-center">
                        <i class="fa fa-crown text-6xl text-gold animate-bounce"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
