@{
    Layout = "~/Views/Shared/_BoCucQuanTri.cshtml";
    ViewBag.Title = "Tổng quan hệ thống (Admin)";
}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Thẻ thống kê -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa fa-users"></i>
        </div>
        <div>
            <p class="text-xs font-medium text-slate-500">Khách hàng</p>
            <p class="text-2xl font-black text-slate-800">@((ViewBag.TotalCustomers != null ? (int)ViewBag.TotalCustomers : 0).ToString("N0"))</p>
            <p class="text-[10px] text-green-500 font-bold"><i class="fa fa-arrow-up"></i> Thành viên</p>
        </div>
    </div>
    
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa fa-dollar-sign"></i>
        </div>
        <div>
            <p class="text-xs font-medium text-slate-500">Tổng doanh thu</p>
            <p class="text-xl font-black text-slate-800">@((ViewBag.TotalRevenue != null ? (decimal)ViewBag.TotalRevenue : 0).ToString("N0"))₫</p>
            <p class="text-[10px] text-green-500 font-bold"><i class="fa fa-arrow-up"></i> Đã duyệt</p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa fa-shopping-cart"></i>
        </div>
        <div>
            <p class="text-xs font-medium text-slate-500">Tổng đơn hàng</p>
            <p class="text-2xl font-black text-slate-800">@((ViewBag.TotalOrders != null ? (int)ViewBag.TotalOrders : 0).ToString("N0"))</p>
            <p class="text-[10px] text-green-500 font-bold"><i class="fa fa-arrow-up"></i> Mua sắm</p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
        <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa fa-eye"></i>
        </div>
        <div>
            <p class="text-xs font-medium text-slate-500">Lượt truy cập</p>
            <p class="text-2xl font-black text-slate-800">@((ViewBag.TotalVisits != null ? (int)ViewBag.TotalVisits : 0).ToString("N0"))</p>
            <p class="text-[10px] text-green-500 font-bold"><i class="fa fa-arrow-up"></i> Tương tác</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Hoạt động gần đây -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-bold text-slate-800">Hoạt động gần đây</h3>
            <a href="@Url.Action("Index", "QuanLyDonHang")" class="text-xs text-primary font-bold hover:underline">Xem tất cả</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-[10px] font-bold uppercase tracking-wider">
                        <th class="px-6 py-3">Người dùng</th>
                        <th class="px-6 py-3">Hành động</th>
                        <th class="px-6 py-3">Thời gian</th>
                        <th class="px-6 py-3 text-right">Trạng thái</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @if (ViewBag.RecentOrders != null && (ViewBag.RecentOrders as List<VuongBanDienTu.Models.DonHang>).Count > 0)
                    {
                        foreach (var order in ViewBag.RecentOrders as List<VuongBanDienTu.Models.DonHang>)
                        {
                            <tr>
                                <td class="px-6 py-4 flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center font-bold text-slate-500 text-xs text-center">
                                        @((order.NguoiDung != null && !string.IsNullOrEmpty(order.NguoiDung.HoTen)) ? order.NguoiDung.HoTen.Substring(0, 1).ToUpper() : "K")
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-800 leading-none">@(order.NguoiDung != null ? order.NguoiDung.HoTen : "Khách ẩn danh")</p>
                                        <p class="text-[10px] text-slate-400 mt-1">Khách hàng</p>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-600">
                                    @if (order.TrangThaiDonHang?.Trim() == "Chờ xử lý")
                                    {
                                        <span>Đặt đơn hàng mới <strong class="text-slate-800">#ORD-@order.MaDonHang</strong></span>
                                    }
                                    else if (order.TrangThaiDonHang?.Trim() == "Đã xác nhận")
                                    {
                                        <span>Duyệt & xác nhận đơn <strong class="text-slate-800">#ORD-@order.MaDonHang</strong></span>
                                        if (order.NguoiDung1 != null)
                                        {
                                            <span class="text-[9px] text-slate-400 block uppercase">Bởi: @order.NguoiDung1.HoTen</span>
                                        }
                                    }
                                    else if (order.TrangThaiDonHang?.Trim() == "Đã hủy")
                                    {
                                        <span>Hủy đơn hàng <strong class="text-slate-800">#ORD-@order.MaDonHang</strong></span>
                                        if (!string.IsNullOrEmpty(order.GhiChu))
                                        {
                                            <span class="text-[9px] text-slate-400 block italic">Lý do: @order.GhiChu</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>Cập nhật trạng thái đơn <strong class="text-slate-800">#ORD-@order.MaDonHang</strong></span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-500 text-xs">
                                    @VuongBanDienTu.Helpers.PhanQuyen.GetTimeAgo(order.NgayDat)
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (order.TrangThaiDonHang?.Trim() == "Chờ xử lý")
                                    {
                                        <span class="bg-amber-100 text-amber-700 text-[10px] font-bold px-2 py-0.5 rounded-full">Chờ xử lý</span>
                                    }
                                    else if (order.TrangThaiDonHang?.Trim() == "Đã xác nhận")
                                    {
                                        <span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full">Đã xác nhận</span>
                                    }
                                    else if (order.TrangThaiDonHang?.Trim() == "Đã hủy")
                                    {
                                        <span class="bg-red-100 text-red-700 text-[10px] font-bold px-2 py-0.5 rounded-full">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="bg-slate-100 text-slate-700 text-[10px] font-bold px-2 py-0.5 rounded-full">@order.TrangThaiDonHang</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-8 text-center text-xs font-medium text-slate-400 uppercase tracking-wider">Không có hoạt động nào gần đây</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Biểu đồ thống kê hiệu năng -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col h-full">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="font-bold text-slate-800 text-base">Thống kê hiệu năng</h3>
                <p class="text-[11px] text-slate-400 font-medium mt-0.5">Xu hướng tăng trưởng và tương tác theo tháng</p>
            </div>
            <div class="flex items-center gap-1.5 bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-full text-[10px] font-black uppercase">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> Live
            </div>
        </div>
        
        <div class="relative flex-1 min-h-[300px]">
            <canvas id="metricsChart"></canvas>
        </div>
        
        <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-slate-50">
            <div class="space-y-1">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Tương tác</p>
                <div class="flex items-baseline gap-1.5">
                    <span class="text-base font-black text-slate-700">@((ViewBag.TotalVisits != null ? (int)ViewBag.TotalVisits : 0).ToString("N0"))</span>
                    <span class="text-[9px] font-bold text-green-500"><i class="fa fa-arrow-up-right"></i> +12%</span>
                </div>
            </div>
            <div class="space-y-1">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Doanh thu TB / Đơn</p>
                <div class="flex items-baseline gap-1.5">
                    <span class="text-base font-black text-slate-700">
                        @{
                            var totalRev = ViewBag.TotalRevenue != null ? (decimal)ViewBag.TotalRevenue : 0;
                            var totalOrd = ViewBag.TotalOrders != null ? (int)ViewBag.TotalOrders : 0;
                            var avg = totalOrd > 0 ? (totalRev / totalOrd) : 0;
                            @avg.ToString("N0")
                        }₫
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('metricsChart').getContext('2d');
        
        // Load authentic monthly arrays directly from C# server-side calculations
        const visitsData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MonthlyVisits ?? new int[12]));
        const ordersData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MonthlyOrders ?? new int[12]));
        const revenueData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MonthlyRevenue ?? new decimal[12]));

        // Create gradients
        const revenueGradient = ctx.createLinearGradient(0, 0, 0, 300);
        revenueGradient.addColorStop(0, 'rgba(232, 25, 44, 0.3)');
        revenueGradient.addColorStop(1, 'rgba(232, 25, 44, 0.0)');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Th.1', 'Th.2', 'Th.3', 'Th.4', 'Th.5', 'Th.6', 'Th.7', 'Th.8', 'Th.9', 'Th.10', 'Th.11', 'Th.12'],
                datasets: [
                    {
                        label: 'Lượt truy cập',
                        type: 'bar',
                        data: visitsData,
                        backgroundColor: 'rgba(99, 102, 241, 0.85)',
                        borderColor: '#6366f1',
                        borderWidth: 1.5,
                        borderRadius: 4,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Đơn hàng',
                        type: 'bar',
                        data: ordersData,
                        backgroundColor: 'rgba(245, 158, 11, 0.85)',
                        borderColor: '#f59e0b',
                        borderWidth: 1.5,
                        borderRadius: 4,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Doanh thu tháng (đ)',
                        type: 'line',
                        data: revenueData,
                        fill: true,
                        backgroundColor: revenueGradient,
                        borderColor: '#e8192c',
                        borderWidth: 2.5,
                        tension: 0.4,
                        pointBackgroundColor: '#e8192c',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        yAxisID: 'yRevenue'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            font: { size: 10, weight: 'bold' },
                            color: '#64748b',
                            boxWidth: 12
                        }
                    },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleFont: { size: 11, weight: 'bold' },
                        bodyFont: { size: 12 },
                        padding: 12,
                        cornerRadius: 12,
                        callbacks: {
                            label: function (context) {
                                let val = context.raw;
                                if (context.dataset.yAxisID === 'yRevenue') {
                                    return context.dataset.label + ': ' + val.toLocaleString('vi-VN') + ' ₫';
                                }
                                return context.dataset.label + ': ' + val.toLocaleString('vi-VN');
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 10, weight: 'bold' }, color: '#64748b' }
                    },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        grid: { color: '#f1f5f9' },
                        ticks: { font: { size: 9 }, color: '#64748b' },
                        title: {
                            display: true,
                            text: 'Lượt / Đơn',
                            font: { size: 10, weight: 'bold' },
                            color: '#64748b'
                        }
                    },
                    yRevenue: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: { drawOnChartArea: false },
                        ticks: {
                            font: { size: 9 },
                            color: '#e8192c',
                            callback: function(value) {
                                return (value / 1000000).toFixed(1) + 'M';
                            }
                        },
                        title: {
                            display: true,
                            text: 'Doanh thu (₫)',
                            font: { size: 10, weight: 'bold' },
                            color: '#e8192c'
                        }
                    }
                }
            }
        });
    });
</script>
