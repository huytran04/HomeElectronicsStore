@model IEnumerable<VuongBanDienTu.Models.LichSuHoatDong>
@{
    Layout = "~/Views/Shared/_BoCucQuanTri.cshtml";
    ViewBag.Title = "Lịch sử hoạt động toàn hệ thống";
}

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden mb-6">
    <!-- Header & Filters Area -->
    <div class="p-6 border-b border-slate-100">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h3 class="text-lg font-black text-slate-800 tracking-tight">Lịch Sử Hoạt Động</h3>
                <p class="text-xs text-slate-400 mt-1 font-medium">Theo dõi và giám sát toàn bộ hoạt động của hệ thống theo thời gian thực.</p>
            </div>
            
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-slate-500 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200">
                    Tổng số bản ghi: <strong class="text-primary font-black" id="totalRecords">@Model.Count()</strong>
                </span>
            </div>
        </div>

        <!-- Filters Block -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
            <!-- Search Input -->
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <i class="fa fa-search text-xs"></i>
                </span>
                <input type="text" id="searchInput" placeholder="Tìm kiếm tài khoản, họ tên, hành động..." 
                       class="w-full pl-9 pr-4 py-2 text-xs font-medium text-slate-700 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-primary/50 focus:bg-white transition-all shadow-sm" />
            </div>

            <!-- Role Filter -->
            <div class="relative">
                <select id="roleFilter" class="w-full px-3.5 py-2 text-xs font-bold text-slate-600 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-primary/50 focus:bg-white transition-all shadow-sm cursor-pointer appearance-none">
                    <option value="">Tất cả vai trò</option>
                    <option value="Admin">Admin</option>
                    <option value="Quản lý">Quản lý</option>
                    <option value="Nhân viên">Nhân viên</option>
                    <option value="Thử việc">Thử việc</option>
                    <option value="Khách hàng">Khách hàng</option>
                </select>
                <span class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                    <i class="fa fa-chevron-down text-[10px]"></i>
                </span>
            </div>

            <!-- Status Filter -->
            <div class="relative">
                <select id="statusFilter" class="w-full px-3.5 py-2 text-xs font-bold text-slate-600 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-primary/50 focus:bg-white transition-all shadow-sm cursor-pointer appearance-none">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Thành công">Thành công / Hoàn thành / Đã duyệt</option>
                    <option value="Chờ xử lý">Chờ xử lý / Đang xử lý</option>
                    <option value="Thất bại">Thất bại / Hủy bỏ / Đã hủy</option>
                </select>
                <span class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                    <i class="fa fa-chevron-down text-[10px]"></i>
                </span>
            </div>

            <!-- Date Range Select / Refresh -->
            <div class="flex items-center gap-2">
                <button onclick="window.location.reload();" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2 text-xs font-bold text-slate-600 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-xl transition-all shadow-sm">
                    <i class="fa fa-sync-alt"></i> Tải lại
                </button>
            </div>
        </div>
    </div>

    <!-- Table Grid -->
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="logTable">
            <thead>
                <tr class="bg-slate-50 text-slate-500 text-[10px] font-black uppercase tracking-wider border-b border-slate-100">
                    <th class="px-6 py-3.5 text-center w-16">Mã Log</th>
                    <th class="px-6 py-3.5">Người thực hiện</th>
                    <th class="px-6 py-3.5">Hành động</th>
                    <th class="px-6 py-3.5">Chi tiết / Ghi chú</th>
                    <th class="px-6 py-3.5">Thời gian</th>
                    <th class="px-6 py-3.5 text-right w-36">Trạng thái</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
                @if (Model != null && Model.Any())
                {
                    foreach (var log in Model)
                    {
                        string statusText = log.TrangThai ?? "Thành công";
                        string statusClass = "bg-slate-100 text-slate-600 border border-slate-200";
                        if (statusText == "Thành công" || statusText == "Đã xác nhận" || statusText == "Hoàn thành")
                        {
                            statusClass = "bg-green-50 text-green-700 border border-green-200";
                        }
                        else if (statusText == "Thất bại" || statusText == "Đã hủy")
                        {
                            statusClass = "bg-red-50 text-red-700 border border-red-200";
                        }
                        else if (statusText == "Chờ xử lý" || statusText == "Chờ thanh toán")
                        {
                            statusClass = "bg-amber-50 text-amber-700 border border-amber-200";
                        }

                        string roleBadge = "bg-slate-100 text-slate-500 border border-slate-200";
                        if (log.VaiTro == "Admin") { roleBadge = "bg-red-50 text-red-700 border border-red-150 font-bold"; }
                        else if (log.VaiTro == "Quản lý") { roleBadge = "bg-blue-50 text-blue-700 border border-blue-150 font-bold"; }
                        else if (log.VaiTro == "Nhân viên") { roleBadge = "bg-purple-50 text-purple-700 border border-purple-150 font-bold"; }
                        else if (log.VaiTro == "Thử việc") { roleBadge = "bg-amber-50 text-amber-700 border border-amber-150 font-bold"; }

                        <tr class="log-row hover:bg-slate-50/50 transition-colors" 
                            data-search="@(log.MaLog) @(log.TenDangNhap?.ToLower()) @(log.HoTen?.ToLower()) @(log.HanhDong?.ToLower()) @(log.ChiTiet?.ToLower())"
                            data-role="@(log.VaiTro)"
                            data-status="@(statusText)">
                            <td class="px-6 py-4 text-center font-bold text-slate-400 text-xs">
                                #@log.MaLog
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-slate-600 text-xs uppercase shadow-sm">
                                        @(string.IsNullOrEmpty(log.TenDangNhap) ? "KH" : log.TenDangNhap.Substring(0, Math.Min(log.TenDangNhap.Length, 2)))
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-800 leading-none">@log.HoTen</p>
                                        <div class="flex items-center gap-1.5 mt-1.5">
                                            <span class="text-[9px] px-1.5 py-0.5 rounded @roleBadge">@log.VaiTro</span>
                                            <span class="text-[10px] text-slate-400 font-semibold">@@@log.TenDangNhap</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 font-bold text-slate-700 max-w-[200px] break-words">
                                @log.HanhDong
                            </td>
                            <td class="px-6 py-4 text-slate-500 text-xs max-w-[300px] break-words leading-relaxed font-medium">
                                @log.ChiTiet
                            </td>
                            <td class="px-6 py-4 text-slate-400 text-xs whitespace-nowrap">
                                <i class="fa-regular fa-clock mr-1"></i> @log.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td class="px-6 py-4 text-right whitespace-nowrap">
                                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full @statusClass">@statusText</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="noRecordsRow">
                        <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                            <i class="fa fa-history text-3xl mb-3 block opacity-30"></i>
                            <span class="text-sm font-bold uppercase tracking-wider">Không có hoạt động nào được ghi lại</span>
                        </td>
                    </tr>
                }
                <tr id="searchEmptyRow" class="hidden">
                    <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                        <i class="fa fa-magnifying-glass text-3xl mb-3 block opacity-30"></i>
                        <span class="text-sm font-bold uppercase tracking-wider">Không tìm thấy kết quả phù hợp</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("searchInput");
            const roleFilter = document.getElementById("roleFilter");
            const statusFilter = document.getElementById("statusFilter");
            const rows = document.querySelectorAll(".log-row");
            const totalRecordsSpan = document.getElementById("totalRecords");
            const searchEmptyRow = document.getElementById("searchEmptyRow");

            function filterTable() {
                const searchVal = searchInput.value.toLowerCase().trim();
                const roleVal = roleFilter.value;
                const statusVal = statusFilter.value;
                
                let visibleCount = 0;

                rows.forEach(row => {
                    const searchText = row.getAttribute("data-search");
                    const roleText = row.getAttribute("data-role");
                    const statusText = row.getAttribute("data-status");

                    // Search condition
                    const matchesSearch = !searchVal || searchText.includes(searchVal);
                    
                    // Role condition
                    const matchesRole = !roleVal || roleText === roleVal;

                    // Status condition
                    let matchesStatus = true;
                    if (statusVal) {
                        if (statusVal === "Thành công") {
                            matchesStatus = (statusText === "Thành công" || statusText === "Đã xác nhận" || statusText === "Hoàn thành");
                        } else if (statusVal === "Chờ xử lý") {
                            matchesStatus = (statusText === "Chờ xử lý" || statusText === "Chờ thanh toán");
                        } else if (statusVal === "Thất bại") {
                            matchesStatus = (statusText === "Thất bại" || statusText === "Đã hủy");
                        }
                    }

                    if (matchesSearch && matchesRole && matchesStatus) {
                        row.classList.remove("hidden");
                        visibleCount++;
                    } else {
                        row.classList.add("hidden");
                    }
                });

                totalRecordsSpan.textContent = visibleCount;

                if (visibleCount === 0 && rows.length > 0) {
                    searchEmptyRow.classList.remove("hidden");
                } else {
                    searchEmptyRow.classList.add("hidden");
                }
            }

            if (searchInput) searchInput.addEventListener("input", filterTable);
            if (roleFilter) roleFilter.addEventListener("change", filterTable);
            if (statusFilter) statusFilter.addEventListener("change", filterTable);
        });
    </script>
}
