@using VuongBanDienTu.Models
@using VuongBanDienTu.Helpers
@{
    Layout = "~/Views/Shared/_BoCucQuanTri.cshtml";
    ViewBag.Title = "Thiết lập quyền bằng Dropdown";
    var roles = ViewBag.Roles as IEnumerable<VaiTro>;
    var permissions = ViewBag.Permissions as IEnumerable<QuyenHan>;
}

<div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="bg-white p-10 rounded-[3rem] shadow-sm border border-slate-100 flex flex-col md:flex-row justify-between items-center gap-8">
        <div>
            <h2 class="text-4xl font-black text-slate-800 uppercase tracking-tighter">Phân quyền thông minh</h2>
            <p class="text-base text-slate-400 font-medium mt-2">Gán danh sách chức danh cho từng hành động một cách trực quan</p>
        </div>
        <button onclick="document.getElementById('addPermModal').classList.remove('hidden')" class="bg-primary text-white px-10 py-5 rounded-2xl font-black text-xs uppercase tracking-widest shadow-2xl shadow-red-100 hover:bg-primary-dark hover:-translate-y-1 transition-all">
            <i class="fa fa-plus-circle mr-2 text-lg"></i> Tạo mã quyền mới
        </button>
    </div>

    @if (!permissions.Any())
    {
        <div class="bg-white p-20 rounded-[4rem] text-center border border-slate-100 shadow-sm">
            <div class="w-32 h-32 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-8">
                <i class="fa fa-shield-cat text-5xl text-slate-200"></i>
            </div>
            <h3 class="text-2xl font-black text-slate-800 uppercase">Chưa có mã quyền nào</h3>
            <p class="text-slate-400 mt-4 mb-10 max-w-sm mx-auto font-medium">Bạn cần khởi tạo các mã quyền hành động (ví dụ: Duyệt hàng, Xóa đơn) trước khi gán cho các vai trò.</p>
            <button onclick="initDefaultPermissions()" class="bg-primary text-white px-12 py-5 rounded-3xl font-black text-sm uppercase tracking-widest shadow-2xl shadow-red-100 hover:bg-primary-dark transition-all">
                Khởi tạo quyền cơ bản ngay
            </button>
        </div>
    }
    else
    {
        <!-- Action-Based List -->
        <div class="grid grid-cols-1 gap-6">
            @foreach (var perm in permissions)
            {
                <div class="bg-white p-8 rounded-[2.5rem] shadow-sm border border-slate-100 group hover:shadow-xl hover:shadow-slate-100/50 transition-all duration-300">
                    <div class="flex flex-col lg:flex-row items-start lg:items-center gap-8">
                        <!-- Perm Info -->
                        <div class="flex-shrink-0 w-full lg:w-72">
                            <div class="flex items-center gap-4 mb-2">
                                <div class="w-12 h-12 bg-primary/5 text-primary rounded-2xl flex items-center justify-center">
                                    <i class="fa fa-bolt-lightning text-xl"></i>
                                </div>
                                <h4 class="text-xl font-black text-slate-800 uppercase tracking-tight">@perm.TenQuyen</h4>
                            </div>
                            <span class="px-4 py-1.5 bg-slate-100 rounded-xl text-[10px] font-black text-slate-400 uppercase tracking-widest">CODE: @perm.Code</span>
                        </div>

                        <!-- Assigned Roles (Tags) -->
                        <div class="flex-1">
                            <h5 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                                <i class="fa fa-users-viewfinder text-xs"></i> Các chức danh được thực hiện
                            </h5>
                            <div class="flex flex-wrap gap-2.5">
                                @foreach (var role in roles.Where(r => r.QuyenHans.Any(p => p.MaQuyen == perm.MaQuyen)))
                                {
                                    <div class="pl-4 pr-2 py-2 bg-blue-50 border border-blue-100 rounded-xl flex items-center gap-3 animate-in zoom-in-95">
                                        <span class="text-xs font-black text-blue-600 uppercase tracking-tight">@role.TenVaiTro</span>
                                        <button onclick="updateRolePermission(@role.MaVaiTro, @perm.MaQuyen, false)" 
                                                class="w-7 h-7 rounded-lg hover:bg-red-500 hover:text-white text-blue-300 transition-all flex items-center justify-center">
                                            <i class="fa fa-times text-[10px]"></i>
                                        </button>
                                    </div>
                                }
                                
                                <!-- Add Role Dropdown for this Perm -->
                                <div class="relative">
                                    <select onchange="if(this.value) updateRolePermission(this.value, @perm.MaQuyen, true); this.value='';" 
                                            class="appearance-none bg-slate-50 hover:bg-slate-100 border-2 border-dashed border-slate-200 rounded-xl px-4 py-2 text-xs font-black uppercase text-slate-400 cursor-pointer transition-all outline-none">
                                        <option value="">+ Thêm chức danh</option>
                                        @foreach (var role in roles.Where(r => !r.QuyenHans.Any(p => p.MaQuyen == perm.MaQuyen)))
                                        {
                                            <option value="@role.MaVaiTro">@role.TenVaiTro</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Actions -->
                        <div class="flex-shrink-0 flex gap-2">
                             <button onclick="deletePermission(@perm.MaQuyen)" class="w-12 h-12 bg-slate-50 text-slate-300 hover:bg-red-50 hover:text-red-500 rounded-2xl transition-all flex items-center justify-center">
                                <i class="fa fa-trash-can"></i>
                             </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Modal remains the same but styled better -->
    <div id="addPermModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md">
        <div class="bg-white rounded-[4rem] shadow-2xl max-w-md w-full p-14 transform transition-all animate-in zoom-in-95">
            <div class="text-center mb-10">
                <div class="w-20 h-20 bg-primary/10 text-primary rounded-3xl flex items-center justify-center mx-auto mb-6">
                    <i class="fa fa-key text-3xl"></i>
                </div>
                <h3 class="text-3xl font-black text-slate-800 uppercase tracking-tighter">Tạo quyền mới</h3>
                <p class="text-slate-400 font-medium mt-2">Ví dụ: Quản lý kho, Duyệt thanh toán...</p>
            </div>
            
            <form onsubmit="handleCreatePerm(event)" class="space-y-6">
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Tên hành động</label>
                    <input type="text" id="tenQuyen" placeholder="Nhập tên tiếng Việt..." required class="w-full px-8 py-5 bg-slate-50 border-none rounded-2xl outline-none focus:ring-4 focus:ring-primary/10 transition-all font-bold text-base">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Mã hệ thống (Uppercase)</label>
                    <input type="text" id="code" placeholder="VÍ DỤ: QUAN_LY_KHO" required class="w-full px-8 py-5 bg-slate-50 border-none rounded-2xl outline-none focus:ring-4 focus:ring-primary/10 transition-all font-bold text-base uppercase">
                </div>
                <button type="submit" class="w-full py-6 bg-primary text-white rounded-3xl font-black uppercase tracking-widest shadow-2xl shadow-red-200 hover:bg-primary-dark hover:-translate-y-1 transition-all mt-4">
                    Xác nhận thêm mã quyền
                </button>
                <button type="button" onclick="document.getElementById('addPermModal').classList.add('hidden')" class="w-full py-4 text-slate-400 font-black uppercase text-xs tracking-widest hover:text-slate-600 transition-colors">
                    Hủy bỏ
                </button>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        async function updateRolePermission(maVaiTro, maQuyen, hasPermission) {
            try {
                const response = await fetch('@Url.Action("UpdatePermission")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `maVaiTro=${maVaiTro}&maQuyen=${maQuyen}&hasPermission=${hasPermission}`
                });
                const res = await response.json();
                if (res.success) location.reload();
                else showToast(res.message, 'error');
            } catch (err) {
                showToast('Lỗi kết nối', 'error');
            }
        }

        async function handleCreatePerm(e) {
            e.preventDefault();
            const tenQuyen = document.getElementById('tenQuyen').value;
            const code = document.getElementById('code').value.toUpperCase();
            try {
                const response = await fetch('@Url.Action("CreatePermission")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `tenQuyen=${tenQuyen}&code=${code}`
                });
                const res = await response.json();
                if (res.success) location.reload(); else showToast(res.message, 'error');
            } catch (err) { showToast('Lỗi kết nối', 'error'); }
        }

        async function deletePermission(id) {
            if(!confirm('Bạn có chắc muốn xóa mã quyền này?')) return;
            try {
                const response = await fetch('@Url.Action("DeletePermission")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}`
                });
                const res = await response.json();
                if (res.success) location.reload();
            } catch (err) { showToast('Lỗi kết nối', 'error'); }
        }

        async function initDefaultPermissions() {
            const defaults = [
                { t: 'Truy cập quản trị', c: 'TRUY_CAP_QUAN_TRI' },
                { t: 'Thêm hàng', c: 'THEM_HANG' },
                { t: 'Duyệt đơn', c: 'DUYET_DON' }
            ];
            for (const p of defaults) {
                await fetch('@Url.Action("CreatePermission")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `tenQuyen=${p.t}&code=${p.c}`
                });
            }
            location.reload();
        }
    </script>
}
