        function filterOrders(status) {
            const rows = document.querySelectorAll('.order-row');
            rows.forEach(row => {
                const orderStatus = row.getAttribute('data-status');
                if (status === 'Tất cả' || orderStatus === status) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
