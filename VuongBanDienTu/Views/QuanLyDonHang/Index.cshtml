@model IEnumerable<VuongBanDienTu.Models.DonHang>

@{
    Layout = "~/Views/Shared/_BoCucQuanTri.cshtml";
    ViewBag.Title = "Quản lý đơn hàng";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
        <div>
            <h2 class="text-xl font-black text-slate-800">Quản lý Đơn hàng</h2>
            <p class="text-xs text-slate-400 font-medium">Theo dõi và xử lý đơn đặt hàng từ khách hàng</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-slate-400">Bộ lọc:</span>
            <select id="statusFilter" onchange="filterOrders(this.value)" class="bg-slate-50 border-none rounded-lg text-xs font-bold px-3 py-2 outline-none cursor-pointer">
                <option value="Tất cả">Tất cả đơn hàng</option>
                <option value="Chờ xử lý">Chờ xử lý</option>
                <option value="Đã xác nhận">Đã xác nhận</option>
                <option value="Đang giao">Đang giao</option>
                <option value="Hoàn thành">Hoàn thành</option>
                <option value="Chờ hoàn tiền">Chờ hoàn tiền</option>
                <option value="Đã hủy">Đã hủy</option>
            </select>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50">
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Mã Đơn</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Khách hàng</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Ngày đặt</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Tổng tiền</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Trạng thái</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var item in Model)
                    {
                        <tr class="order-row hover:bg-slate-50/50 transition-colors group" data-status="@(item.TrangThaiDonHang != null ? item.TrangThaiDonHang.Trim() : "")">
                            <td class="px-6 py-4">
                                <span class="text-xs font-black text-slate-800 uppercase">#ORD-@item.MaDonHang</span>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm font-black text-slate-800">@(item.NguoiDung != null ? item.NguoiDung.HoTen : "Khách ẩn danh")</p>
                                <div class="flex flex-col gap-1 mt-1">
                                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-tight">Sản phẩm:</p>
                                    <div class="space-y-0.5">
                                        @foreach (var ct in item.ChiTietDonHangs)
                                        {
                                            <p class="text-[11px] font-bold text-slate-600 truncate max-w-[200px]">• @ct.SanPham.TenSanPham (@ct.SoLuong)</p>
                                        }
                                    </div>
                                    <p class="text-[10px] text-primary font-black mt-1">SĐT: @(item.NguoiDung != null ? item.NguoiDung.SoDienThoai : "---")</p>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-xs font-medium text-slate-500">
                                @(item.NgayDat.HasValue ? item.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "---")
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm font-black text-slate-800">@(item.TongTien.HasValue ? item.TongTien.Value.ToString("N0") : "0")₫</span>
                                <div class="mt-1">
                                    @if (item.TrangThaiThanhToan == "Đã thanh toán") {
                                        <span class="text-[9px] font-black text-green-600 bg-green-50 px-1.5 py-0.5 rounded uppercase">Đã trả tiền</span>
                                    } else {
                                        <span class="text-[9px] font-black text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded uppercase">Chưa trả tiền</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="relative min-w-[130px]">
                                    <select onchange="updateOrderStatus(@item.MaDonHang, this.value)" 
                                        @(item.TrangThaiDonHang?.Trim() == "Đã hủy" ? "disabled" : "")
                                        class="w-full bg-slate-50 border-none rounded-lg text-[10px] font-black uppercase px-2.5 py-1.5 outline-none focus:ring-2 focus:ring-primary/10 transition-all
                                        @(item.TrangThaiDonHang?.Trim() == "Đã hủy" ? "cursor-not-allowed opacity-75" : "cursor-pointer")
                                        @(item.TrangThaiDonHang?.Trim() == "Chờ xử lý" ? "text-amber-600 bg-amber-50" : 
                                          item.TrangThaiDonHang?.Trim() == "Đã xác nhận" ? "text-green-600 bg-green-50" :
                                          item.TrangThaiDonHang?.Trim() == "Đang giao" ? "text-blue-600 bg-blue-50" :
                                          item.TrangThaiDonHang?.Trim() == "Hoàn thành" ? "text-purple-600 bg-purple-50" :
                                          item.TrangThaiDonHang?.Trim() == "Đã hủy" ? "text-primary bg-red-50" : "text-slate-600 bg-slate-100")">
                                        <option value="Chờ xử lý" @(item.TrangThaiDonHang?.Trim() == "Chờ xử lý" ? "selected" : "")>Chờ xử lý</option>
                                        <option value="Đã xác nhận" @(item.TrangThaiDonHang?.Trim() == "Đã xác nhận" ? "selected" : "")>Đã xác nhận</option>
                                        <option value="Đang giao" @(item.TrangThaiDonHang?.Trim() == "Đang giao" ? "selected" : "")>Đang giao</option>
                                        <option value="Hoàn thành" @(item.TrangThaiDonHang?.Trim() == "Hoàn thành" ? "selected" : "")>Hoàn thành</option>
                                        <option value="Chờ hoàn tiền" @(item.TrangThaiDonHang?.Trim() == "Chờ hoàn tiền" ? "selected" : "")>Chờ hoàn tiền</option>
                                        <option value="Đã hủy" @(item.TrangThaiDonHang?.Trim() == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                                    </select>
                                    @if (item.NguoiDung1 != null)
                                    {
                                        <p class="text-[9px] text-slate-400 font-bold uppercase mt-1 px-1">Bởi: @item.NguoiDung1.HoTen</p>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button onclick="openDetailsModal(@item.MaDonHang)" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-400 hover:bg-slate-200 hover:-translate-y-0.5 hover:scale-[1.05] active:scale-[0.97] transition-all flex items-center justify-center cursor-pointer" title="Xem chi tiết">
                                        <i class="fa fa-eye text-xs"></i>
                                    </button>
                                    @if (item.TrangThaiDonHang != null && item.TrangThaiDonHang.Trim() == "Chờ hoàn tiền")
                                    {
                                        <button onclick="openRefundModal(@item.MaDonHang)" class="px-3 py-1.5 rounded-lg bg-orange-500 text-white text-[10px] font-black uppercase hover:bg-orange-600 hover:-translate-y-0.5 hover:shadow-md hover:scale-[1.03] active:scale-[0.97] transition-all shadow-lg shadow-orange-100 cursor-pointer">
                                            Duyệt hoàn tiền
                                        </button>
                                    }
                                    <button onclick="openCancelModal(@item.MaDonHang)" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-400 text-[10px] font-black uppercase hover:bg-red-50 hover:text-primary transition-all cursor-pointer" title="Hủy đơn hàng">
                                        Hủy đơn
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Chi Tiết Đơn Hàng -->
<div id="detailsModal" class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300">
    <div class="bg-white rounded-[2.5rem] shadow-2xl max-w-2xl w-full overflow-hidden transform scale-95 transition-all duration-300" id="detailsContent">
        <!-- Nội dung AJAX sẽ tải vào đây -->
        <div class="p-20 text-center">
            <i class="fa fa-circle-notch fa-spin text-primary text-3xl mb-4"></i>
            <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Đang tải chi tiết...</p>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Duyệt Đơn -->
<div id="confirmModal" class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300">
    <div class="bg-white rounded-[2rem] shadow-2xl max-w-sm w-full overflow-hidden transform scale-95 transition-all duration-300" id="confirmContent">
        <div class="p-8 text-center">
            <div class="w-20 h-20 bg-green-50 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fa fa-check-double text-3xl"></i>
            </div>
            <h3 class="text-xl font-black text-slate-800 mb-2 uppercase">Duyệt đơn hàng?</h3>
            <p class="text-xs text-slate-400 font-medium mb-8 leading-relaxed">Bạn có chắc chắn muốn duyệt đơn hàng này? <br>Hệ thống sẽ tự động **trừ sản phẩm trong kho**!</p>
            
            <input type="hidden" id="confirmOrderId">
            
            <div class="flex flex-col gap-3">
                <button onclick="submitApproveOrder()" id="btnConfirmApprove" class="w-full py-4 bg-green-600 text-white rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-green-700 transition-all shadow-xl shadow-green-100">Xác nhận duyệt ngay</button>
                <button onclick="closeConfirmModal()" class="w-full py-4 bg-slate-50 text-slate-500 rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-slate-100 transition-all">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Hủy Đơn -->
<div id="cancelModal" class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300">
    <div class="bg-white rounded-[2rem] shadow-2xl max-w-sm w-full overflow-hidden transform scale-95 transition-all duration-300" id="cancelContent">
        <div class="p-8 text-center">
            <div class="w-20 h-20 bg-red-50 text-primary rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fa fa-exclamation-triangle text-3xl"></i>
            </div>
            <h3 class="text-xl font-black text-slate-800 mb-2 uppercase">Hủy đơn hàng?</h3>
            <p class="text-xs text-slate-400 font-medium mb-6 leading-relaxed">Bạn có chắc chắn muốn hủy đơn hàng này? <br>Vui lòng nhập lý do hủy dưới đây:</p>
            
            <input type="hidden" id="cancelOrderId">
            <textarea id="cancelReason" rows="3" class="w-full px-4 py-3 bg-slate-50 border-2 border-transparent rounded-2xl outline-none focus:bg-white focus:border-primary/20 transition-all font-semibold text-xs text-slate-700 resize-none mb-6" placeholder="Nhập lý do hủy..."></textarea>
            
            <div class="flex flex-col gap-3">
                <button onclick="submitCancelOrder()" id="btnConfirmCancel" class="w-full py-4 bg-primary text-white rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-red-800 transition-all shadow-xl shadow-red-100">Xác nhận hủy đơn</button>
                <button onclick="closeCancelModal()" class="w-full py-4 bg-slate-50 text-slate-500 rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-slate-100 transition-all">Quay lại</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Duyệt Hoàn Tiền -->
<div id="refundModal" class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300">
    <div class="bg-white rounded-[2rem] shadow-2xl max-w-sm w-full overflow-hidden transform scale-95 transition-all duration-300" id="refundContent">
        <div class="p-8 text-center">
            <div class="w-20 h-20 bg-orange-50 text-orange-500 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fa fa-rotate-left text-3xl"></i>
            </div>
            <h3 class="text-xl font-black text-slate-800 mb-2 uppercase">Duyệt hoàn tiền?</h3>
            <p class="text-xs text-slate-400 font-medium mb-8 leading-relaxed">Xác nhận duyệt hoàn tiền cho đơn hàng này.<br>Email xác nhận sẽ được gửi tự động đến khách hàng.</p>
            <input type="hidden" id="refundOrderId">
            <div class="flex flex-col gap-3">
                <button onclick="submitRefundApproval()" id="btnConfirmRefund" class="w-full py-4 bg-orange-500 text-white rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-orange-600 transition-all shadow-xl shadow-orange-100">Xác nhận duyệt hoàn tiền</button>
                <button onclick="closeRefundModal()" class="w-full py-4 bg-slate-50 text-slate-500 rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-slate-100 transition-all">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Giao Hàng -->
<div id="shipModal" class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300">
    <div class="bg-white rounded-[2rem] shadow-2xl max-w-sm w-full overflow-hidden transform scale-95 transition-all duration-300" id="shipContent">
        <div class="p-8 text-center">
            <div class="w-20 h-20 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fa fa-truck text-3xl"></i>
            </div>
            <h3 class="text-xl font-black text-slate-800 mb-2 uppercase">Giao đơn hàng?</h3>
            <p class="text-xs text-slate-400 font-medium mb-8 leading-relaxed">Xác nhận chuyển trạng thái đơn hàng sang "Đang giao"? <br>Hệ thống sẽ cập nhật trạng thái đơn hàng cho người dùng.</p>
            
            <input type="hidden" id="shipOrderId">
            
            <div class="flex flex-col gap-3">
                <button onclick="submitShipOrder()" id="btnConfirmShip" class="w-full py-4 bg-blue-600 text-white rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-blue-700 transition-all shadow-xl shadow-blue-100">Xác nhận giao hàng</button>
                <button onclick="closeShipModal()" class="w-full py-4 bg-slate-50 text-slate-500 rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-slate-100 transition-all">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Hoàn Thành -->
<div id="completeModal" class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300">
    <div class="bg-white rounded-[2rem] shadow-2xl max-w-sm w-full overflow-hidden transform scale-95 transition-all duration-300" id="completeContent">
        <div class="p-8 text-center">
            <div class="w-20 h-20 bg-purple-50 text-purple-600 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fa fa-check-circle text-3xl"></i>
            </div>
            <h3 class="text-xl font-black text-slate-800 mb-2 uppercase">Hoàn thành đơn?</h3>
            <p class="text-xs text-slate-400 font-medium mb-8 leading-relaxed">Xác nhận đơn hàng đã giao thành công (Hoàn thành)? <br>Thao tác này không thể hoàn tác.</p>
            
            <input type="hidden" id="completeOrderId">
            
            <div class="flex flex-col gap-3">
                <button onclick="submitCompleteOrder()" id="btnConfirmComplete" class="w-full py-4 bg-purple-600 text-white rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-purple-700 transition-all shadow-xl shadow-purple-100">Xác nhận hoàn thành</button>
                <button onclick="closeCompleteModal()" class="w-full py-4 bg-slate-50 text-slate-500 rounded-2xl font-black uppercase text-[11px] tracking-widest hover:bg-slate-100 transition-all">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        async function updateOrderStatus(id, status) {
            try {
                const response = await fetch('@Url.Action("UpdateStatus", "QuanLyDonHang")', {
                    method: 'POST',
                    body: new URLSearchParams({ id: id, status: status }),
                    headers: { 
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });
                const data = await response.json();
                if (data.success) {
                    showToast(data.message || 'Cập nhật thành công!', 'success');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.message || 'Lỗi xử lý!', 'error');
                }
            } catch (err) {
                showToast('Lỗi kết nối!', 'error');
            }
        }

        function approveOrder(id) {
            document.getElementById('confirmOrderId').value = id;
            const modal = document.getElementById('confirmModal');
            const content = document.getElementById('confirmContent');
            modal.classList.remove('invisible', 'opacity-0');
            modal.classList.add('opacity-100');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }

        function closeConfirmModal() {
            const modal = document.getElementById('confirmModal');
            const content = document.getElementById('confirmContent');
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('invisible');
            }, 300);
        }

        async function submitApproveOrder() {
            const id = document.getElementById('confirmOrderId').value;
            const btn = document.getElementById('btnConfirmApprove');
            const originalText = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin mr-2"></i> ĐANG XỬ LÝ...';

            try {
                const response = await fetch('@Url.Action("Duyet", "QuanLyDonHang")?id=' + id, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await response.json();
                if (data.success) {
                    showToast('Đã duyệt đơn hàng thành công!', 'success');
                    location.reload();
                } else {
                    showToast(data.message || 'Lỗi xử lý!', 'error');
                }
            } catch (err) {
                showToast('Lỗi kết nối!', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        async function openDetailsModal(id) {
            const modal = document.getElementById('detailsModal');
            const content = document.getElementById('detailsContent');
            
            modal.classList.remove('invisible', 'opacity-0');
            modal.classList.add('opacity-100');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');

            try {
                const response = await fetch('@Url.Action("GetChiTiet", "QuanLyDonHang")?id=' + id);
                const html = await response.text();
                content.innerHTML = html;
            } catch (err) {
                content.innerHTML = '<div class="p-20 text-center text-primary font-black uppercase tracking-widest">Lỗi tải dữ liệu!</div>';
            }
        }

        function closeDetailsModal() {
            const modal = document.getElementById('detailsModal');
            const content = document.getElementById('detailsContent');
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('invisible');
                content.innerHTML = '<div class="p-20 text-center"><i class="fa fa-circle-notch fa-spin text-primary text-3xl mb-4"></i><p class="text-xs font-black text-slate-400 uppercase tracking-widest">Đang tải chi tiết...</p></div>';
            }, 300);
        }

        function openCancelModal(id) {
            document.getElementById('cancelOrderId').value = id;
            const modal = document.getElementById('cancelModal');
            const content = document.getElementById('cancelContent');
            modal.classList.remove('invisible', 'opacity-0');
            modal.classList.add('opacity-100');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }

        function closeCancelModal() {
            const modal = document.getElementById('cancelModal');
            const content = document.getElementById('cancelContent');
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('invisible');
                document.getElementById('cancelReason').value = '';
            }, 300);
        }

        async function submitCancelOrder() {
            const id = document.getElementById('cancelOrderId').value;
            const reason = document.getElementById('cancelReason').value;
            
            if (!reason) {
                showToast('Vui lòng nhập lý do hủy!', 'warning');
                return;
            }

            const btn = document.getElementById('btnConfirmCancel');
            const originalText = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin mr-2"></i> ĐANG XỬ LÝ...';

            try {
                const response = await fetch('@Url.Action("Huy", "QuanLyDonHang")', {
                    method: 'POST',
                    body: new URLSearchParams({ id: id, lyDo: reason }),
                    headers: { 
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });
                const data = await response.json();
                if (data.success) {
                    showToast('Đã hủy đơn hàng thành công!', 'success');
                    location.reload();
                } else {
                    showToast(data.message || 'Lỗi xử lý!', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi kết nối!', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        function openRefundModal(id) {
            document.getElementById('refundOrderId').value = id;
            const modal = document.getElementById('refundModal');
            const content = document.getElementById('refundContent');
            modal.classList.remove('invisible', 'opacity-0');
            modal.classList.add('opacity-100');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }

        function closeRefundModal() {
            const modal = document.getElementById('refundModal');
            const content = document.getElementById('refundContent');
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => modal.classList.add('invisible'), 300);
        }

