@model VuongBanDienTu.Models.NguoiDung

@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Check if user has uploaded avatar
    var avatarPath = "/Content/Avatars/avatar_" + Model.MaNguoiDung + ".png";
    var physicalPath = Server.MapPath("~" + avatarPath);
    var hasAvatar = System.IO.File.Exists(physicalPath);
    var avatarUrl = hasAvatar ? avatarPath + "?t=" + DateTime.Now.Ticks : "";
}

<div class="bg-slate-50 min-h-screen py-12">
    <div class="max-w-4xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <!-- Sidebar -->
            <div class="md:col-span-4 space-y-4">
                <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100 text-center">
                    <div class="relative w-24 h-24 mx-auto mb-4 group cursor-pointer" onclick="document.getElementById('avatarInput').click()">
                        @if (hasAvatar)
                        {
                            <img id="avatarDisplay" src="@avatarUrl" alt="Avatar" class="w-full h-full object-cover rounded-full border-2 border-primary/20 shadow-md transition-all group-hover:opacity-75" />
                        }
                        else
                        {
                            <div id="avatarPlaceholder" class="w-full h-full bg-primary/10 text-primary rounded-full flex items-center justify-center text-3xl font-black transition-all group-hover:bg-primary/20">
                                @Model.HoTen.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <!-- Edit overlay -->
                        <div class="absolute inset-0 bg-black/40 rounded-full opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold">
                            <i class="fa fa-camera mr-1"></i> Tải ảnh
                        </div>
                    </div>
                    <!-- Hidden input file -->
                    <input type="file" id="avatarInput" accept="image/*" class="hidden" onchange="uploadAvatar(this)" />

                    <h3 class="text-xl font-black text-slate-800">@Model.HoTen</h3>
                    <p class="text-xs text-slate-400 font-medium mt-1">@Model.Email</p>
                    
                    <div class="mt-8 pt-8 border-t border-slate-50 space-y-2 text-left">
                        <a href="@Url.Action("ThongTinCaNhan", "TaiKhoan")" class="flex items-center gap-3 px-4 py-3 bg-primary text-white rounded-xl font-black text-xs uppercase tracking-widest transition-all">
                            <i class="fa fa-user"></i>
                            Hồ sơ cá nhân
                        </a>
                        <a href="@Url.Action("Index", "DonHang")" class="flex items-center gap-3 px-4 py-3 text-slate-500 hover:bg-slate-50 rounded-xl font-black text-xs uppercase tracking-widest transition-all">
                            <i class="fa fa-shopping-bag"></i>
                            Đơn hàng của tôi
                        </a>
                        <a href="@Url.Action("DangXuat", "TaiKhoan")" class="flex items-center gap-3 px-4 py-3 text-red-400 hover:bg-red-50 rounded-xl font-black text-xs uppercase tracking-widest transition-all">
                            <i class="fa fa-sign-out"></i>
                            Đăng xuất
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="md:col-span-8">
                <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-8 md:p-12">
                        <div class="mb-10">
                            <h2 class="text-2xl font-black text-slate-800">Thiết lập tài khoản</h2>
                            <p class="text-sm text-slate-400 font-medium mt-2">Cập nhật thông tin cá nhân và địa chỉ giao hàng mặc định của bạn.</p>
                        </div>

                        <form id="profileForm" class="space-y-6">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-4">Họ và tên</label>
                                    <input type="text" name="HoTen" value="@Model.HoTen" required 
                                           class="w-full px-6 py-4 bg-slate-50 border-2 border-transparent rounded-2xl outline-none focus:bg-white focus:border-primary/20 transition-all font-bold text-sm">
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-4">Số điện thoại</label>
                                    <input type="tel" name="SoDienThoai" value="@Model.SoDienThoai" required
                                           class="w-full px-6 py-4 bg-slate-50 border-2 border-transparent rounded-2xl outline-none focus:bg-white focus:border-primary/20 transition-all font-bold text-sm">
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-4">Địa chỉ Email</label>
                                <input type="email" name="Email" value="@Model.Email" required
                                       class="w-full px-6 py-4 bg-slate-50 border-2 border-transparent rounded-2xl outline-none focus:bg-white focus:border-primary/20 transition-all font-bold text-sm">
                            </div>

                            <div class="space-y-2">
                                <div class="flex items-center justify-between ml-4">
                                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Địa chỉ giao hàng mặc định</label>
                                    <span class="text-[10px] font-black text-primary bg-primary/5 px-2 py-0.5 rounded">QUAN TRỌNG</span>
                                </div>
                                <textarea name="DiaChi" rows="3" required
                                          class="w-full px-6 py-4 bg-slate-50 border-2 border-transparent rounded-2xl outline-none focus:bg-white focus:border-primary/20 transition-all font-bold text-sm resize-none"
                                          placeholder="Nhập địa chỉ nhận hàng chi tiết của bạn...">@Model.DiaChi</textarea>
                            </div>

                            <div class="pt-6">
                                <button type="submit" id="btnSave" class="w-full sm:w-fit px-12 py-4 bg-primary text-white rounded-2xl font-black uppercase text-xs tracking-widest hover:bg-primary-dark transition-all shadow-xl shadow-red-100 hover:-translate-y-1 active:translate-y-0">
                                    Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.getElementById('profileForm').onsubmit = async function(e) {
            e.preventDefault();
            
            const hoTenInput = this.querySelector('input[name="HoTen"]');
            const sdtInput = this.querySelector('input[name="SoDienThoai"]');
            const hoTen = hoTenInput.value.trim();
            const sdt = sdtInput.value.trim();
            
            const nameRegex = /^[a-zA-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚÝàáâãèéêìíòóôõùúýĂăĐđĨĩŨũƠơƯưẠạẢảẤấẦầẨẩẪẫẬậẮắẰằẲẳẴẵẶặẸẹẺẻẼẽẾếỀềỂểỄễỆệỈỉỊịỌọỎỏỐốỒồỔổỖỗỘộỚớỜờỞởỠỡỢợỤụỦủỨứỪừỬửỮữỰựỲỳỶỷỸỹỴỵ\s]+$/;
            const phoneRegex = /^0[35789]\d{8}$/;
            
            if (!nameRegex.test(hoTen)) {
                showToast("Họ và tên chỉ được nhập chữ, không được chứa số hay ký tự đặc biệt!", "error");
                hoTenInput.focus();
                return false;
            }
            
            if (!phoneRegex.test(sdt)) {
                showToast("Số điện thoại không đúng định dạng! Vui lòng nhập 10 chữ số bắt đầu bằng 03, 05, 07, 08 hoặc 09.", "error");
                sdtInput.focus();
                return false;
            }
            
            const btn = document.getElementById('btnSave');
            const originalText = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin mr-2"></i> Đang lưu...';

            const formData = new FormData(this);
            
            try {
                const response = await fetch('@Url.Action("CapNhatThongTin", "TaiKhoan")', {
                    method: 'POST',
                    body: formData, // Gửi trực tiếp FormData
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                        // Không để Content-Type để trình duyệt tự set multipart/form-data kèm boundary
                    }
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message, 'success');
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ!', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        };

        async function uploadAvatar(input) {
            if (!input.files || !input.files[0]) return;
            
            const file = input.files[0];
            const formData = new FormData();
            formData.append('avatar', file);
            
            showToast('Đang tải lên ảnh đại diện...', 'info');
            
            try {
                const response = await fetch('@Url.Action("UploadAvatar", "TaiKhoan")', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message, 'success');
                    
                    const avatarDisplay = document.getElementById('avatarDisplay');
                    if (avatarDisplay) {
                        avatarDisplay.src = data.avatarUrl;
                    } else {
                        const placeholder = document.getElementById('avatarPlaceholder');
                        if (placeholder) {
                            const container = placeholder.parentElement;
                            placeholder.remove();
                            
                            const img = document.createElement('img');
                            img.id = 'avatarDisplay';
                            img.src = data.avatarUrl;
                            img.alt = 'Avatar';
                            img.className = 'w-full h-full object-cover rounded-full border-2 border-primary/20 shadow-md transition-all group-hover:opacity-75';
                            container.insertBefore(img, container.firstChild);
                        }
                    }
                    setTimeout(() => { window.location.reload(); }, 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi tải ảnh lên máy chủ!', 'error');
            }
        }
    </script>
}
