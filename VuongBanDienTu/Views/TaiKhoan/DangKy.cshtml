@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - VươngBánĐiệnTử</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#e8192c',
                        'primary-dark': '#c0001a',
                        facebook: '#3b5998',
                        google: '#4285f4'
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body { font-family: 'Inter', sans-serif; }
        .tab-active { border-bottom: 2px solid #e8192c; color: #e8192c; font-weight: 700; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
    
    <!-- Header -->
    <header class="bg-primary text-white h-12 flex items-center shadow-md">
        <div class="max-w-screen-xl mx-auto w-full px-4 flex justify-between items-center text-xs font-medium">
            <div class="flex items-center gap-8">
                <a href="@Url.Action("Index", "Home")" class="hover:underline transition-all">Trở về</a>
            </div>
            <div class="text-xl font-black italic tracking-tighter uppercase">
                <span class="text-yellow-400">VUONG</span>DIENTU
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center p-4">
        <div class="w-full max-w-[480px] bg-white rounded-lg shadow-sm border border-gray-200 p-8">
            
            <!-- Tabs -->
            <div class="flex justify-center gap-12 mb-8 border-b border-gray-100">
                <button class="pb-3 text-sm tab-active uppercase tracking-wider">ĐĂNG KÝ</button>
                <a href="@Url.Action("DangNhap", "TaiKhoan")" class="pb-3 text-sm font-bold text-gray-400 hover:text-gray-600 transition-colors uppercase tracking-wider">ĐĂNG NHẬP</a>
            </div>

            <!-- Register Form -->
            <form action="@Url.Action("DangKy", "TaiKhoan")" method="post" class="space-y-4">
                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-50 text-primary text-xs font-bold p-3 rounded-md border border-red-100 flex items-center gap-2 mb-4">
                        <i class="fa fa-circle-exclamation"></i>
                        @ViewBag.Error
                    </div>
                }

                <div class="relative">
                    <input type="text" name="TenDangNhap" required placeholder="Tên đăng nhập" 
                           class="w-full border border-gray-200 rounded px-4 py-3 text-sm outline-none focus:border-primary transition-all placeholder:text-gray-400">
                </div>

                <div class="relative flex flex-col">
                    <div class="relative">
                        <input type="password" name="MatKhau" required placeholder="Nhập mật khẩu" id="matKhauInput"
                               class="w-full border border-gray-200 rounded px-4 py-3 pr-10 text-sm outline-none focus:border-primary transition-all placeholder:text-gray-400">
                        <span onclick="togglePasswordVisibility('matKhauInput', this)" class="absolute right-3 top-3.5 cursor-pointer text-gray-400 hover:text-gray-600 transition-colors">
                            <i class="fa fa-eye"></i>
                        </span>
                    </div>
                    <p class="text-[10px] text-gray-400 mt-1 font-medium leading-relaxed">
                        <i class="fa fa-info-circle mr-1"></i> Mật khẩu phải tối thiểu 8 ký tự, chứa ít nhất 1 chữ hoa, 1 chữ thường và 1 ký tự đặc biệt.
                    </p>
                </div>

                <div class="relative">
                    <input type="text" name="HoTen" required placeholder="Họ và tên" 
                           class="w-full border border-gray-200 rounded px-4 py-3 text-sm outline-none focus:border-primary transition-all placeholder:text-gray-400">
                </div>

                <div class="relative">
                    <input type="email" name="Email" required placeholder="Email" 
                           class="w-full border border-gray-200 rounded px-4 py-3 text-sm outline-none focus:border-primary transition-all placeholder:text-gray-400">
                </div>

                <div class="relative">
                    <input type="tel" name="SoDienThoai" required placeholder="Số điện thoại" 
                           class="w-full border border-gray-200 rounded px-4 py-3 text-sm outline-none focus:border-primary transition-all placeholder:text-gray-400">
                </div>

                <div class="flex items-start gap-2 px-1 py-2">
                    <input type="checkbox" required id="terms" class="mt-1">
                    <label for="terms" class="text-[11px] text-gray-500 leading-tight">
                        Tôi đồng ý với các <a href="#" class="text-blue-600">điều khoản dịch vụ</a> và <a href="#" class="text-blue-600">chính sách bảo mật</a>
                    </label>
                </div>

                <button type="submit" class="w-full bg-primary text-white font-bold py-3.5 rounded shadow-sm hover:bg-primary-dark transition-all flex items-center justify-center gap-2 tracking-widest uppercase">
                    ĐĂNG KÝ <i class="fa fa-chevron-right text-[10px]"></i>
                </button>
            </form>

            <!-- Separator -->
            <div class="flex items-center gap-4 my-8">
                <div class="flex-1 h-px bg-gray-200"></div>
                <span class="text-xs text-gray-400 font-medium">Hoặc</span>
                <div class="flex-1 h-px bg-gray-200"></div>
            </div>

            <!-- Social Logins -->
            <div class="space-y-3 text-center">
                <p class="text-[11px] text-gray-400 mb-4">Bạn đã có tài khoản? <a href="@Url.Action("DangNhap", "TaiKhoan")" class="text-primary font-bold">ĐĂNG NHẬP NGAY</a></p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-50 border-t border-gray-200 py-4">
        <div class="max-w-screen-xl mx-auto px-4 text-center text-[11px] text-gray-600 font-medium">
            Bạn gặp khó khăn khi đăng nhập, đăng ký? Gọi <span class="text-primary font-bold">1800 6800</span> để được hỗ trợ tốt nhất.
        </div>
    </footer>

    <script>
        const form = document.querySelector('form');
        const matKhauInput = document.getElementById('matKhauInput');
        const hoTenInput = document.querySelector('input[name="HoTen"]');
        const sdtInput = document.querySelector('input[name="SoDienThoai"]');
        
        form.addEventListener('submit', function (e) {
            const matKhau = matKhauInput.value;
            const hoTen = hoTenInput.value.trim();
            const sdt = sdtInput.value.trim();
            
            // Name validation (Vietnamese letters and spaces only, no numbers or special characters)
            const nameRegex = /^[a-zA-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚÝàáâãèéêìíòóôõùúýĂăĐđĨĩŨũƠơƯưẠạẢảẤấẦầẨẩẪẫẬậẮắẰằẲẳẴẵẶặẸẹẺẻẼẽẾếỀềỂểỄễỆệỈỉỊịỌọỎỏỐốỒồỔổỖỗỘộỚớỜờỞởỠỡỢợỤụỦủỨứỪừỬửỮữỰựỲỳỶỷỸỹỴỵ\s]+$/;
            
            // Phone validation (Vietnamese standard format, 10 digits starting with 03, 05, 07, 08, 09)
            const phoneRegex = /^0[35789]\d{8}$/;
            
            let errMsg = "";
            
            if (!nameRegex.test(hoTen)) {
                errMsg = "Họ và tên chỉ được nhập chữ, không được chứa số hay ký tự đặc biệt!";
                hoTenInput.focus();
            } else if (!phoneRegex.test(sdt)) {
                errMsg = "Số điện thoại không đúng định dạng! Vui lòng nhập 10 chữ số bắt đầu bằng 03, 05, 07, 08 hoặc 09.";
                sdtInput.focus();
            } else if (matKhau.length < 8) {
                errMsg = "Mật khẩu phải tối thiểu 8 ký tự!";
                matKhauInput.focus();
            } else {
                const hasUpperCase = /[A-Z]/.test(matKhau);
                const hasLowerCase = /[a-z]/.test(matKhau);
                const hasSpecialChar = /[^a-zA-Z0-9]/.test(matKhau);
                if (!hasUpperCase || !hasLowerCase || !hasSpecialChar) {
                    errMsg = "Mật khẩu phải chứa ít nhất 1 chữ hoa, 1 chữ thường và 1 ký tự đặc biệt!";
                    matKhauInput.focus();
                }
            }
            
            if (errMsg) {
                e.preventDefault();
                
                // Show error message box dynamically
                let errBox = document.getElementById('dynamicErrorBox');
                if (!errBox) {
                    errBox = document.createElement('div');
                    errBox.id = 'dynamicErrorBox';
                    errBox.className = 'bg-red-50 text-primary text-xs font-bold p-3 rounded-md border border-red-100 flex items-center gap-2 mb-4';
                    form.insertBefore(errBox, form.firstChild);
                }
                errBox.innerHTML = `<i class="fa fa-circle-exclamation"></i> <span>${errMsg}</span>`;
                
                // Remove old MVC errors if any
                const mvcError = form.querySelector('.bg-red-50:not(#dynamicErrorBox)');
                if (mvcError) mvcError.remove();
                
                return false;
            }
        });

        function togglePasswordVisibility(inputId, toggleEl) {
            const input = document.getElementById(inputId);
            const icon = toggleEl.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa fa-eye';
            }
        }
    </script>
</body>
</html>
