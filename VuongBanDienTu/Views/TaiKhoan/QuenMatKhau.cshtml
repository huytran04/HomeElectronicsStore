@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - VươngBánĐiệnTử</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#e8192c',
                        'primary-dark': '#c0001a',
                        facebook: '#3b5998',
                        google: '#4285f4'
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
    
    <!-- Header -->
    <header class="bg-primary text-white h-12 flex items-center shadow-md">
        <div class="max-w-screen-xl mx-auto w-full px-4 flex justify-between items-center text-xs font-medium">
            <div class="flex items-center gap-8">
                <a href="@Url.Action("DangNhap", "TaiKhoan")" class="hover:underline transition-all flex items-center gap-1.5">
                    <i class="fa fa-arrow-left"></i> Quay lại đăng nhập
                </a>
            </div>
            <div class="text-xl font-black italic tracking-tighter uppercase">
                <span class="text-yellow-400">VUONG</span>DIENTU
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center p-4">
        <div class="w-full max-w-[480px] bg-white rounded-lg shadow-sm border border-gray-200 p-8">
            
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-red-50 text-primary rounded-full flex items-center justify-center mx-auto mb-4 border border-red-100">
                    <i class="fa fa-key text-2xl"></i>
                </div>
                <h2 class="text-xl font-black text-slate-800 uppercase tracking-wide">Quên Mật Khẩu?</h2>
                <p class="text-xs text-slate-400 font-semibold mt-1">Nhập thông tin tài khoản của bạn để nhận mật khẩu tạm thời</p>
            </div>

            <!-- Forgot Password Form -->
            <form action="@Url.Action("QuenMatKhau", "TaiKhoan")" method="post" class="space-y-4">
                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-50 text-primary text-xs font-bold p-3 rounded-md border border-red-100 flex items-center gap-2 mb-4">
                        <i class="fa fa-circle-exclamation text-sm"></i>
                        @ViewBag.Error
                    </div>
                }

                <div class="space-y-1">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block ml-1">Tên đăng nhập / Tài khoản</label>
                    <input type="text" name="TenDangNhap" required placeholder="Nhập tên đăng nhập của bạn" 
                           class="w-full border border-gray-200 rounded px-4 py-3 text-sm outline-none focus:border-primary transition-all placeholder:text-gray-400 font-bold text-slate-700">
                </div>

                <div class="space-y-1">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block ml-1">Email đăng ký</label>
                    <input type="email" name="Email" required placeholder="Nhập email khớp với tài khoản" 
                           class="w-full border border-gray-200 rounded px-4 py-3 text-sm outline-none focus:border-primary transition-all placeholder:text-gray-400 font-bold text-slate-700">
                </div>

                <div class="bg-amber-50 border border-amber-100 text-amber-800 text-[11px] p-3.5 rounded-lg flex gap-2.5 font-medium leading-relaxed my-2">
                    <i class="fa fa-info-circle text-amber-500 mt-0.5 text-sm flex-shrink-0"></i>
                    <div>
                        Hệ thống sẽ xác minh thông tin tài khoản và gửi một mật khẩu tạm thời mới đến địa chỉ Email trên để bạn có thể truy cập lại.
                    </div>
                </div>

                <button type="submit" class="w-full bg-primary text-white font-bold py-3.5 rounded shadow-sm hover:bg-primary-dark transition-all flex items-center justify-center gap-2 tracking-widest uppercase text-sm">
                    GỬI YÊU CẦU <i class="fa fa-paper-plane text-xs"></i>
                </button>
            </form>

            <div class="text-center mt-8 border-t border-gray-100 pt-6">
                <p class="text-xs text-gray-500 font-semibold">
                    Nhớ ra mật khẩu? 
                    <a href="@Url.Action("DangNhap", "TaiKhoan")" class="text-primary hover:underline font-bold">Đăng nhập ngay</a>
                </p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-50 border-t border-gray-200 py-4">
        <div class="max-w-screen-xl mx-auto px-4 text-center text-[11px] text-gray-600 font-medium">
            Bạn gặp khó khăn khi lấy lại mật khẩu? Gọi <span class="text-primary font-bold">1800 6800</span> để được hỗ trợ tốt nhất.
        </div>
    </footer>

</body>
</html>
